<Project>
  <!--
    Central Package Management (#841): every DotCharter package version lives
    here; a csproj names the package and never the version. Dependabot (see
    .github/dependabot.yml) edits this file.

    JuceSharp/ is a separate repository that keeps its own versions in its
    csproj files, so central management is switched off for projects under it.
    A project that needs a different version than the one listed here uses
    VersionOverride on its PackageReference, and says why next to it.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ManagePackageVersionsCentrally Condition="$(MSBuildProjectDirectory.Contains('\JuceSharp\'))">false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AlphaSkia.Native.Windows" Version="3.5.147" />
    <PackageVersion Include="AlphaTab" Version="1.8.4" />
    <PackageVersion Include="Anthropic" Version="12.55.0" />
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.8" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.8" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.1.0.8" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Silk.NET.Core" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
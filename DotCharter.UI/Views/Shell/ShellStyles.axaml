<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ══════════════════════════════════════════════════════════════════
         The SHELL vocabulary (0.38 visual pass).

         v0.35 gave Settings one row grammar (Views/Settings/SettingsStyles.axaml)
         and v0.37 gave the Play Mode content screens one screen grammar
         (eyebrow / title / accent rule / subtitle, figure-first tiles, panels
         lit from above). Everything OUTSIDE those two — the song library, the
         toolbar flyouts, the status bar, the command palette, the diagnostics
         window — still each invented its own header, its own card and its own
         chip. This file is the third and last copy of that same grammar, so the
         app reads as ONE product instead of three.

         Rules it obeys, and that anything added here must keep obeying:

           • Tokens only. Every colour is a {DynamicResource} brush, every size
             comes from the Space*/Gap*/Padding*/FontSize*/Radius* scales. No
             literal FontSize, no literal colour.
           • NO new Color token. The lit-panel fills (PlayPanelFill /
             PlayTileFill / PlayTopLight, Styles/Resources.axaml) already exist
             and are already derived from the theme's colour tokens — they are
             named after where they landed first, not after who may use them, so
             the shell reuses them rather than minting a parallel set. That
             keeps the theme-completeness gate (ThemeTokens.All) untouched.
           • NO transitions and NO animations. Several of the surfaces that
             include this file are IsVisible-gated (the command palette, the
             stacked-track rail), and a hidden control's style clocks keep
             ticking — DotCharter.UI/AGENTS.md.
           • NO Cursor setter, for the same reason SettingsStyles.axaml forbids
             one: building a Cursor resolves ICursorFactory from the platform,
             and these styles must stay constructible without one. Views that
             want a hand cursor set it inline.
         ══════════════════════════════════════════════════════════════════ -->

    <Styles.Resources>
        <!-- The search glass. Styles/Icons.axaml carries IconMagnifyPlus and
             IconMagnifyMinus — the two ZOOM verbs — but no plain glass, and that
             file is off limits to this pass: a duplicate x:Key in it builds
             clean and then crashes the app at App.Initialize(). So the one
             geometry the shell's search fields need lives here, under a Shell*
             key that can never collide with an Icon* one. Same path the command
             palette used to inline verbatim; if a plain `IconMagnify` ever lands
             in Icons.axaml, delete this and point the three consumers at it.

             `Geometry` is the ONE type worth naming here: parsing one needs
             `IPlatformRenderInterface` off the locator, so it must be resolved
             on a real UI thread with the platform up. That is a constraint on
             CALLERS, not on the declaration — see the note in
             ShellConstructionUiPerfSmokeTests.WithLaidOut about why a view must
             be constructed on the session's dispatcher thread. -->
        <StreamGeometry x:Key="ShellIconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    </Styles.Resources>

    <!-- ─── Header block ────────────────────────────────────────────────
         The four-part lockup every screen and every panel opens with:

             <TextBlock Classes="Eyebrow"       … />   LIBRARY
             <TextBlock Classes="Title"         … />   Song browser
             <Border    Classes="HeaderRule" />        ▁▁▁▁
             <TextBlock Classes="ScreenSubtitle" … />  one sentence of what it is

         `Title` comes from Styles/Typography.axaml (the shared type scale);
         only the three that Typography has no opinion about live here. -->
    <Style Selector="TextBlock.Eyebrow">
        <Setter Property="FontFamily" Value="{StaticResource FireFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FireSizeEyebrow}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextDim}" />
    </Style>
    <Style Selector="TextBlock.ScreenSubtitle">
        <Setter Property="FontFamily" Value="{StaticResource FireFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FireSizeMd}" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The short glowing underline. Same element as the Play Mode screens'
         header rule, so a shell screen and a game screen open identically. -->
    <Style Selector="Border.HeaderRule">
        <Setter Property="Height" Value="3" />
        <Setter Property="Width" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{StaticResource FireRadiusTag}" />
        <Setter Property="Background" Value="{DynamicResource FireAccentBar}" />
        <Setter Property="Margin" Value="{StaticResource FireGapTopSm}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ─── Surfaces, lit from above ────────────────────────────────────
         R1/R3 of pedalboard-visual-language.md (retired v0.43; see docs/agents/ui/pedalboard.md) applied to flat
         UI: a panel is LIT along its top edge and settles into shadow at the
         bottom, so it reads as a raised slab and not a rectangle of a slightly
         different grey. The light is in the gradient + the TopLight hairline,
         never in a drop shadow. -->
    <Style Selector="Border.ShellPanel">
        <Setter Property="Background" Value="{DynamicResource FirePanelFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireBorderHair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FireRadiusCardLg}" />
        <Setter Property="BoxShadow" Value="{DynamicResource FireShadowPanel}" />
    </Style>
    <Style Selector="Border.ShellCard">
        <Setter Property="Background" Value="{DynamicResource FireSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireBorderHair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FireRadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource FirePadCard}" />
    </Style>
    <!-- The 1 px lit edge. Sits INSIDE a panel/card as its own element (a
         border cannot carry two brushes), fades out at both ends, never eats a
         pointer. -->
    <Style Selector="Border.TopLight">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource FireWashTop}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ─── The accent icon badge ───────────────────────────────────────
         Same 30 px accent-faint square Settings puts in front of a group
         title (Border.GroupIconBox / PathIcon.GroupIcon), renamed so the two
         vocabularies can be included side by side without colliding. Geometry
         must arrive via {DynamicResource IconX} — a StaticResource inside
         deferred template content cannot see app-level resources, and a
         DynamicResource miss is silent, which is exactly what the smoke test
         asserts against. -->
    <Style Selector="Border.ShellBadge">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="{StaticResource FireRadiusRow}" />
        <Setter Property="Background" Value="{DynamicResource FireAccentTintSoft}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="PathIcon.ShellBadgeIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource FireAccent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ─── Chips ───────────────────────────────────────────────────────
         An inline fact about a row: an arrangement set, a tuning, a keyboard
         shortcut, a counter. Neutral container, semantic INK — the chip never
         floods with the semantic colour, because a list of five saturated
         pills is a list with no hierarchy at all (R4: colour is information). -->
    <Style Selector="Border.ShellChip">
        <Setter Property="Background" Value="{DynamicResource FireSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireBorderHair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FireRadiusTag}" />
        <Setter Property="Padding" Value="{StaticResource FirePadChip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ShellChip TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FireSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextSecondary}" />
    </Style>
    <!-- The one accent-lit chip a surface is allowed: a live count, a state
         that is ON. -->
    <Style Selector="Border.ShellChip.Accent">
        <Setter Property="Background" Value="{DynamicResource FireAccentTintSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireAccentTint}" />
    </Style>
    <Style Selector="Border.ShellChip.Accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FireAccent}" />
    </Style>
    <Style Selector="Border.ShellChip.Warn">
        <Setter Property="Background" Value="{DynamicResource FireWarningTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireWarning}" />
    </Style>
    <Style Selector="Border.ShellChip.Warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FireWarning}" />
    </Style>
    <Style Selector="Border.ShellChip.Danger">
        <Setter Property="Background" Value="{DynamicResource FireDangerTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FireDangerBorder}" />
    </Style>
    <Style Selector="Border.ShellChip.Danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FireDanger}" />
    </Style>

    <!-- ─── A labelled field ────────────────────────────────────────────
         Filter/search controls get a caption ABOVE them rather than a
         placeholder that vanishes the moment the field has content. A filter
         bar whose active filters are unlabelled is a filter bar you cannot
         read at a glance, which is the entire job of a filter bar. -->
    <Style Selector="TextBlock.FieldCaption">
        <Setter Property="FontFamily" Value="{StaticResource FireFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FireSizeEyebrow}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextDim}" />
        <Setter Property="Margin" Value="{StaticResource FireGapRowSm}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ─── Figures ─────────────────────────────────────────────────────
         Figure first, unit second, label under. LineHeight is NOT decoration:
         a figure that also wears `Mono` inherits Typography's LineHeight=16,
         which clips a 20 px numeral to a middle band. -->
    <Style Selector="TextBlock.Figure">
        <Setter Property="FontFamily" Value="{StaticResource FireFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FireSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextPrimary}" />
        <Setter Property="LineHeight" Value="{StaticResource FireLineHeightFigure}" />
    </Style>
    <Style Selector="TextBlock.FigureLabel">
        <Setter Property="FontFamily" Value="{StaticResource FireFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FireSizeEyebrow}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FireTextDim}" />
    </Style>

    <!-- ─── Section rule ────────────────────────────────────────────────
         A hairline between the sections of a flyout or a panel. Replaces the
         four different one-off `<Border Height="1" …>` recipes the shell had. -->
    <Style Selector="Border.SectionRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource FireBorderHair}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</Styles>

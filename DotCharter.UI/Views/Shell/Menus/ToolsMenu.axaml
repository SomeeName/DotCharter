<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:viewModels="using:DotCharter.UI.ViewModels.Shell"
          xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
          xmlns:converters="using:DotCharter.UI.Converters"
          x:Class="DotCharter.UI.Views.Shell.Menus.ToolsMenu"
          x:DataType="viewModels:MainWindowViewModel"
          Classes="FireMenuTop" Header="{localization:Loc Menu_Tools}">
    <!-- In the order a chart is made (#491): generate, fix, ask the AI, repeat, tones.
         One level of groups, nothing deeper (MainMenuLocalizationTests caps Tools at 10 rows). -->

    <!-- What the app can write for you: hand positions, hand shapes, structure, levels. -->
    <MenuItem Header="{localization:Loc Menu_GroupGenerate}" SubmenuOpened="OnGenerateGroupOpened">
        <MenuItem.Icon>
            <PathIcon
                Data="M4,20V18H7V5H9V18H12V10H14V18H17V8H19V18H22V20H4Z"
                Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
        <!-- One row for both scopes: its text says whether it will act on the selection or the arrangement. -->
        <MenuItem Header="{Binding EditingAvailability.GenerateFhpLabel}"
                  AutomationProperties.Name="{Binding EditingAvailability.GenerateFhpLabel}"
                  Command="{Binding FhpGeneration.GenerateFhpForScopeCommand}"
                  InputGesture="{Binding ProjectState.Keybinds.GenerateFhp, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}"
                  ToolTip.Tip="{localization:Loc Menu_Generate_Fhp_Tip}" />
        <Separator />
        <MenuItem Header="{localization:Loc Menu_Generate_HandShape}"
                  AutomationProperties.Name="{localization:Loc Menu_GenerateHandShape}"
                  Command="{Binding GenerateHandShapeCommand}" IsEnabled="{Binding EditingAvailability.Enabled[GenerateHandShape]}" ToolTip.Tip="{Binding EditingAvailability[GenerateHandShape]}" ToolTip.ShowOnDisabled="True"
                  InputGesture="{Binding ProjectState.Keybinds.GenerateHandShape, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}" />
        <MenuItem Header="{localization:Loc Menu_Generate_Arpeggio}"
                  AutomationProperties.Name="{localization:Loc Menu_GenerateArpeggio}"
                  Command="{Binding GenerateArpeggioCommand}" IsEnabled="{Binding EditingAvailability.Enabled[GenerateArpeggio]}" ToolTip.Tip="{Binding EditingAvailability[GenerateArpeggio]}" ToolTip.ShowOnDisabled="True"
                  InputGesture="{Binding ProjectState.Keybinds.GenerateArpeggio, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}" />
        <MenuItem Header="{localization:Loc Menu_Generate_HandShapesArrangement}"
                  AutomationProperties.Name="{localization:Loc Menu_GenerateHandShapesArrangement}"
                  Command="{Binding GenerateHandShapesForArrangementCommand}" />
        <MenuItem Header="{localization:Loc Menu_Generate_AcceptSuggested}"
                  Command="{Binding AcceptSuggestedHandShapesCommand}"
                  InputGesture="{Binding ProjectState.Keybinds.AcceptSuggestedHandShapes, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}"
                  IsEnabled="{Binding EditingAvailability.Enabled[AcceptSuggestedHandShapes]}" ToolTip.Tip="{Binding EditingAvailability[AcceptSuggestedHandShapes|Menu_AcceptSuggestedHandShapes_Tip]}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{localization:Loc Menu_AcceptSuggestedHandShapes}" />
        <MenuItem Header="{localization:Loc Menu_Generate_AcceptSuggestedArpeggios}"
                  Command="{Binding AcceptSuggestedArpeggiosCommand}"
                  InputGesture="{Binding ProjectState.Keybinds.AcceptSuggestedArpeggios, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}"
                  IsEnabled="{Binding EditingAvailability.Enabled[AcceptSuggestedArpeggios]}" ToolTip.Tip="{Binding EditingAvailability[AcceptSuggestedArpeggios|Menu_AcceptSuggestedArpeggios_Tip]}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="{localization:Loc Menu_AcceptSuggestedArpeggios}" />
        <MenuItem Header="{localization:Loc Menu_Generate_ChordShapeFromHandShape}"
                  AutomationProperties.Name="{localization:Loc Menu_ApplyHandShapeTemplateToChords}"
                  ToolTip.Tip="{localization:Loc Menu_ApplyHandShapeTemplateToChords}"
                  Command="{Binding ApplyHandShapeTemplateToChordsCommand}"
                  InputGesture="{Binding ProjectState.Keybinds.ApplyHandShapeTemplateToChords, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}" />
        <Separator />
        <MenuItem Header="{localization:Loc Menu_Generate_Structure}"
                  AutomationProperties.Name="{localization:Loc Menu_GenerateStructure}"
                  Command="{Binding GenerateStructureCommand}"
                  ToolTip.Tip="{localization:Loc Menu_GenerateStructure_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H15V17H3V15M3,19H21V21H3V19Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_Generate_Levels}"
                  AutomationProperties.Name="{localization:Loc Menu_GenerateLevels}"
                  Command="{Binding ShellDialogs.OpenLevelGenerationCommand}"
                  ToolTip.Tip="{localization:Loc Menu_GenerateLevels_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M11,16H13V18H11V16M8,11H16V13H8V11M5,6H19V8H5V6M3,20V22H21V20H3Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <!-- Repair and reshape what is already charted: look first (the report), then fix. -->
    <MenuItem Header="{localization:Loc Menu_GroupFixChart}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconPulse}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
        <MenuItem Header="{localization:Loc Menu_QualityReport}" Command="{Binding ShellDialogs.OpenQualityReportCommand}"
                  ToolTip.Tip="{localization:Loc Menu_QualityReport_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{localization:Loc Menu_FixChart}" Command="{Binding ShellDialogs.FixChartCommand}"
                  InputGesture="{Binding ProjectState.Keybinds.FixChart, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}"
                  ToolTip.Tip="{localization:Loc Menu_FixChart_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <!-- Also on a right-click of the empty highway; here it is found by someone looking for a fix. -->
        <MenuItem Header="{localization:Loc Timeline_Ctx_ApplyDlcBuilderFixes}"
                  Command="{Binding ApplyDlcBuilderFixesCommand}"
                  ToolTip.Tip="{localization:Loc Menu_ApplyDlcBuilderFixes_Tip}" />
        <Separator />
        <MenuItem Header="{localization:Loc Menu_Refret}" Command="{Binding RefretCommand}"
                  IsEnabled="{Binding EditingAvailability.Enabled[Refret]}" ToolTip.Tip="{Binding EditingAvailability[Refret|Menu_Refret_Tip]}" ToolTip.ShowOnDisabled="True">
            <MenuItem.Icon>
                <PathIcon
                    Data="M17,3L22.25,7.5L17,12L22.25,16.5L17,21V18H14.26L11.44,15.18L13.56,13.06L15.5,15H17V12L17,9H15.5L8.5,16H2V13H7.26L14.26,6H17V3M2,6H8.5L10.75,8.25L8.63,10.38L7.26,9H2V6Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_RemoveDoubleStopNames}"
                  Command="{Binding RemoveDoubleStopChordNamesCommand}"
                  ToolTip.Tip="{localization:Loc Menu_RemoveDoubleStopNames_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M3,5H21V7H3V5M3,11H15V13H3V11M3,17H9V19H3V17M17.6,14.2L19,12.8L20.4,14.2L21.8,12.8L23.2,14.2L21.8,15.6L23.2,17L21.8,18.4L20.4,17L19,18.4L17.6,17L19,15.6L17.6,14.2Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_SquashLevels}" Command="{Binding SquashLevelsCommand}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M5,6H19V8H5V6M8,11H16V13H8V11M11,16H13V18H11V16Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <!-- The AI rows (#497): fingering only, FHP + fingering, FHP only and the two chord names styles are
         jobs in the AI chat panel now; the palette ids of the old rows start the job there. AI settings is
         the panel's own button and Settings > AI. -->
    <MenuItem Header="{localization:Loc Menu_PanelAiChat}" Command="{Binding ShowAiChatCommand}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconChat}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
    </MenuItem>

    <!-- A part that comes back: write it once, keep every repeat the same. -->
    <MenuItem Header="{localization:Loc Menu_GroupRepeats}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconRepeat}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
        <MenuItem Header="{localization:Loc Menu_PropagatePhrase}" Command="{Binding PropagatePhraseCommand}"
                  ToolTip.Tip="{localization:Loc Menu_PropagatePhrase_Tip}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <!-- Links the selected measures with every run that plays the same (linked measures). -->
        <MenuItem Header="{localization:Loc LinkIdentical_Title}"
                  Command="{Binding ChartEditor.LinkedMeasures.LinkIdenticalCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="{localization:Loc LinkIdentical_Tip}">
            <MenuItem.Icon>
                <PathIcon Data="{DynamicResource IconLink}" Width="14" Height="14"
                          Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_LinkedMeasures}" Command="{Binding ShellDialogs.OpenLinkGroupsCommand}"
                  ToolTip.Tip="{localization:Loc Menu_LinkedMeasures_Tip}">
            <MenuItem.Icon>
                <PathIcon Data="{DynamicResource IconSheetMusic}" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <!-- The song's tones and the rig that plays them. -->
    <MenuItem Header="{localization:Loc Menu_GroupTones}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconTune}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
        <MenuItem Header="{localization:Loc Menu_ToneDesigner}"
                  ToolTip.Tip="{localization:Loc Menu_ToneDesigner_Tip}"
                  Command="{Binding ShellDialogs.OpenToneDesignerCommand}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M7,2V4H8V18A4,4 0 0,0 12,22A4,4 0 0,0 16,18V4H17V2H7M11,16C10.4,16 10,15.6 10,15C10,14.4 10.4,14 11,14C11.6,14 12,14.4 12,15C12,15.6 11.6,16 11,16M13,12C12.4,12 12,11.6 12,11C12,10.4 12.4,10 13,10C13.6,10 14,10.4 14,11C14,11.6 13.6,12 13,12M14,7H10V4H14V7Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_Pedalboard}"
                  ToolTip.Tip="{localization:Loc Menu_Pedalboard_Tip}"
                  Command="{Binding ToneRig.OpenPedalboardCommand}">
            <MenuItem.Icon>
                <PathIcon Data="{DynamicResource IconAmp}"
                          Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_GenerateRocksmithTones}"
                  ToolTip.Tip="{localization:Loc Menu_GenerateRocksmithTones_Tip}"
                  Command="{Binding ToneRig.GenerateRocksmithTonesCommand}">
            <MenuItem.Icon>
                <PathIcon Data="{DynamicResource IconSparkles}"
                          Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{localization:Loc Menu_Tuner}"
                  Command="{Binding ShellDialogs.OpenTunerCommand}">
            <MenuItem.Icon>
                <PathIcon
                    Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z"
                    Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <MenuItem Header="{localization:Loc Menu_ShowlightsEditor}"
              Command="{Binding ShellDialogs.OpenShowlightsCommand}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconLightbulb}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
    </MenuItem>
    <!-- The highway screenshot is File ▸ Export and a camera button on the 3D preview header (#494). -->

    <Separator />

    <!-- Inspect charts without changing them: this one against its file, a folder of them. -->
    <MenuItem Header="{localization:Loc Menu_ChartDiff}" Command="{Binding ShellDialogs.OpenChartDiffCommand}">
        <MenuItem.Icon>
            <PathIcon
                Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5A2,2 0 0,0 17,3M11,15H9V13H11V15M11,11H9V9H11V11M15,15H13V13H15V15M15,11H13V9H15V11Z"
                Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{localization:Loc Menu_BatchLint}" Command="{Binding ShellDialogs.OpenBatchLintCommand}"
              ToolTip.Tip="{localization:Loc Menu_BatchLint_Tip}">
        <MenuItem.Icon>
            <PathIcon
                Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M10.94,18L7.4,14.46L8.81,13.05L10.94,15.17L15.19,10.92L16.6,12.33L10.94,18Z"
                Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
    </MenuItem>
</MenuItem>

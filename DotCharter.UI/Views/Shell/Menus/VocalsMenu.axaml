<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:viewModels="using:DotCharter.UI.ViewModels.Shell"
          xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
          xmlns:converters="using:DotCharter.UI.Converters"
          x:Class="DotCharter.UI.Views.Shell.Menus.VocalsMenu"
          x:DataType="viewModels:MainWindowViewModel"
          Classes="FireMenuTop" Header="{localization:Loc Menu_Vocals}">
    <MenuItem Header="{localization:Loc Menu_NewVocalTrack}" Command="{Binding Project.NewVocalTrackCommand}">
        <MenuItem.Icon>
            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14"
                      Foreground="{DynamicResource SuccessColor}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{localization:Loc Menu_DeleteVocalTrack}" Command="{Binding Project.DeleteVocalTrackCommand}">
        <MenuItem.Icon>
            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                      Width="14" Height="14" Foreground="{DynamicResource DangerColor}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Header="{localization:Loc Menu_InsertVocalAtPlayhead}"
              Command="{Binding InsertVocalAtPlayheadCommand}"
              InputGesture="{Binding ProjectState.Keybinds.InsertVocalAtPlayhead, Converter={x:Static converters:KeyChordToGestureConverter.Instance}}" />
    <MenuItem Header="{localization:Loc Menu_VocalTrackSettings}"
              Command="{Binding ShellDialogs.OpenVocalTrackSettingsCommand}">
        <MenuItem.Icon>
            <PathIcon Data="{DynamicResource IconCog}"
                      Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
        </MenuItem.Icon>
    </MenuItem>
</MenuItem>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotCharter.UI.ViewModels.Editor"
             xmlns:controls="using:DotCharter.UI.Controls"
             xmlns:converters="using:DotCharter.UI.Converters"
             xmlns:catalog="clr-namespace:DotCharter.Services.Editing.Catalog;assembly=DotCharter.Services"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.PhraseCatalogView"
             x:DataType="vm:PhraseCatalogViewModel"
             x:CompileBindings="True">
    <!--
        The Riff library tab, laid out as inspector design D: a ColumnFlowPanel of three cards over a pinned
        status footer.
        * The LIBRARY card (pinned head and foot, the list between them scrolls): the find / paste-by-name box
          (EOF's F3 + SHIFT+~ in one control: Enter pastes the typed name), the saved riffs, Paste at playhead.
        * DETAILS: the selected riff — its preview, what it holds, where it came from, the compatibility verdict
          against the arrangement a paste lands in (shown BEFORE the paste), where it pastes (the playhead snapped
          to the beat grid, live), its name typed in place with Rename, and Delete (a two-click latch: a stored
          riff is the ONLY copy, no undo reaches it). Each library row stamps its length in beats.
        * CAPTURE: how many sounds the selection holds, the new riff's name and Capture riff (the highway
          selection; no name = an auto-numbered one).
        At Small the library keeps the left column and Details / Capture share a pager beside it; at Tiny every
        card is paged. The footer prints what the last verb did.
    -->
    <!-- Shares the Inspector's card / field / empty-state vocabulary: it is an Inspector tab. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://DotCharter/Views/Editor/InspectorStyles.axaml" />
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto" Background="{DynamicResource FireSurfaceChrome}">
        <controls:ColumnFlowPanel x:Name="RiffCards" Grid.Row="0" Margin="8,6">
            <!-- ── the library ── -->
            <Border x:Name="RiffListCard" Theme="{StaticResource ColumnFlowFrame}" Classes="ColumnFlowFrame"
                    controls:ColumnFlowPanel.Title="{localization:Loc Panel_PhraseCatalog_Title}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource FireSpaceXs}">
                    <TextBlock Grid.Row="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc Panel_PhraseCatalog_Title}" />
                    <TextBox Grid.Row="1" x:Name="SearchBox" Classes="ColumnFlowField"
                             AutomationProperties.Name="{localization:Loc PhraseCatalog_FindWatermark}"
                             KeyDown="OnSearchKeyDown"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{localization:Loc PhraseCatalog_FindWatermark}"
                             ToolTip.Tip="{localization:Loc PhraseCatalog_FindTip}" />
                    <TextBlock Grid.Row="2" x:Name="RiffEmpty" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                               VerticalAlignment="Top" TextWrapping="Wrap" IsVisible="{Binding !HasEntries}"
                               Text="{localization:Loc PhraseCatalog_EmptyHint}" />
                    <ListBox Grid.Row="2" x:Name="RiffList"
                             AutomationProperties.Name="{localization:Loc Panel_PhraseCatalog_Title}"
                             Background="Transparent" BorderThickness="0" IsVisible="{Binding HasEntries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="catalog:PhraseCatalogEntry">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource FireSpaceXs}">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FireSizeXs}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" x:Name="RiffRowLength" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowStamp"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static converters:RiffLengthConverter.Instance}">
                                                <Binding Path="LengthInBeats" />
                                                <Binding Path="$parent[ListBox].((vm:PhraseCatalogViewModel)DataContext).Localization" />
                                                <Binding Path="$parent[ListBox].((vm:PhraseCatalogViewModel)DataContext).Localization.Culture" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" x:Name="RiffPaste" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary"
                            HorizontalAlignment="Left" IsEnabled="{Binding HasSelection}"
                            AutomationProperties.Name="{localization:Loc PhraseCatalog_PasteAtPlayhead}"
                            ToolTip.Tip="{localization:Loc PhraseCatalog_PasteAtPlayheadTip}"
                            Command="{Binding PasteSelectedCommand}">
                        <TextBlock Text="{localization:Loc PhraseCatalog_PasteAtPlayhead}" TextTrimming="CharacterEllipsis" />
                    </Button>
                </Grid>
            </Border>

            <!-- ── the selected riff ── -->
            <controls:ColumnFlowCard x:Name="RiffDetailsCard" controls:ColumnFlowPanel.Title="{localization:Loc PhraseCatalog_Details}">
                <Panel>
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                               VerticalAlignment="Top" IsVisible="{Binding !HasSelection}"
                               Text="{localization:Loc PhraseCatalog_NoSelection}" />
                    <StackPanel x:Name="RiffDetails" Spacing="{StaticResource FireSpaceXs}" IsVisible="{Binding HasSelection}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" TextWrapping="Wrap"
                                   Text="{Binding SelectedEntry.Name, FallbackValue=''}" />
                        <Border Theme="{StaticResource ColumnFlowFrame}" Classes="ColumnFlowFrame" Padding="0" Height="72" ClipToBounds="True">
                            <controls:PhrasePreviewControl Entry="{Binding SelectedEntry}" />
                        </Border>
                        <TextBlock x:Name="RiffSummary" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                   TextWrapping="Wrap" Text="{Binding SelectedSummary}" />
                        <TextBlock x:Name="RiffSource" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                   TextWrapping="Wrap" Text="{Binding SelectedSourceSummary}" />
                        <!-- The compatibility verdict, shown BEFORE the paste. Two TextBlocks rather than a
                             bool→brush converter so the colour stays a plain DynamicResource token. -->
                        <Panel x:Name="RiffCompatibility">
                            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                       TextWrapping="Wrap" IsVisible="{Binding !CompatibilityIsProblem}"
                                       Text="{Binding CompatibilityMessage}" />
                            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                       TextWrapping="Wrap" Foreground="{DynamicResource FireWarning}"
                                       IsVisible="{Binding CompatibilityIsProblem}"
                                       Text="{Binding CompatibilityMessage}" />
                        </Panel>
                        <Grid x:Name="RiffPastesAtRow" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource FireSpaceXs}"
                              IsVisible="{Binding Readouts, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                       Text="{localization:Loc PhraseCatalog_PastesAt}" />
                            <TextBlock Grid.Column="1" x:Name="RiffPastesAt" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowBody"
                                       TextWrapping="Wrap" Text="{Binding Readouts.PastesAt, FallbackValue=''}" />
                        </Grid>
                        <TextBox x:Name="RiffRenameBox" Classes="ColumnFlowField"
                                 AutomationProperties.Name="{localization:Loc PhraseCatalog_RenameBox}"
                                 PlaceholderText="{localization:Loc PhraseCatalog_RenameBox}"
                                 Text="{Binding RenameText, Mode=TwoWay}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding RenameSelectedCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource FireSpaceXs}">
                            <Button Grid.Column="0" x:Name="RiffRename" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{localization:Loc PhraseCatalog_Rename}"
                                    ToolTip.Tip="{localization:Loc PhraseCatalog_RenameTip}"
                                    Command="{Binding RenameSelectedCommand}">
                                <TextBlock Text="{localization:Loc PhraseCatalog_Rename}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <!-- Two-click confirm latch: the caption swaps to DeleteCaption's confirm text. -->
                            <Button Grid.Column="1" x:Name="RiffDelete" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{localization:Loc PhraseCatalog_Delete}"
                                    Command="{Binding DeleteSelectedCommand}">
                                <TextBlock Text="{Binding DeleteCaption}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Panel>
            </controls:ColumnFlowCard>

            <!-- ── capture the highway selection ── -->
            <controls:ColumnFlowCard x:Name="RiffCaptureCard" controls:ColumnFlowPanel.Title="{localization:Loc PhraseCatalog_Capture}">
                <StackPanel Spacing="{StaticResource FireSpaceXs}">
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc PhraseCatalog_CaptureHeading}" />
                    <TextBlock x:Name="RiffSelectionCount" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                               TextWrapping="Wrap" IsVisible="{Binding Readouts, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding Readouts.SelectionText, FallbackValue=''}" />
                    <TextBox x:Name="NewPhraseNameBox" Classes="ColumnFlowField"
                             AutomationProperties.Name="{localization:Loc PhraseCatalog_NameWatermark}"
                             Text="{Binding NewPhraseName, Mode=TwoWay}"
                             PlaceholderText="{localization:Loc PhraseCatalog_NameWatermark}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CaptureSelectionCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button x:Name="RiffCapture" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{localization:Loc PhraseCatalog_AddSelection}"
                            ToolTip.Tip="{localization:Loc PhraseCatalog_AddSelectionTip}"
                            Command="{Binding CaptureSelectionCommand}">
                        <TextBlock Text="{localization:Loc PhraseCatalog_AddSelection}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding StorageDirectory}"
                               Text="{localization:Loc PhraseCatalog_StorageHint}" />
                </StackPanel>
            </controls:ColumnFlowCard>
        </controls:ColumnFlowPanel>

        <!-- ── the pinned footer: what the last verb did ── -->
        <Border Grid.Row="1" x:Name="RiffFooter" MinHeight="28"
                Background="{DynamicResource FireSurfaceFooter}"
                BorderBrush="{DynamicResource FireBorderSeam}" BorderThickness="0,1,0,0"
                Padding="{StaticResource FirePadTag}">
            <Panel VerticalAlignment="Center">
                <TextBlock x:Name="RiffStatus" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding !StatusIsProblem}"
                           Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" />
                <TextBlock x:Name="RiffStatusProblem" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FireWarning}"
                           IsVisible="{Binding StatusIsProblem}"
                           Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" />
            </Panel>
        </Border>
    </Grid>
</UserControl>

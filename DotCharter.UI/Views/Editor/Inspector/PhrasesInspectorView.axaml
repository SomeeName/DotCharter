<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.PhrasesInspectorView"
             x:DataType="viewModels:PhrasesInspectorViewModel">

    <!--
        v0.29 phrase-iteration browser: every phrase's iterations, time-ordered;
        a row click jumps the editor (the deliberate-seek funnel), and the
        Propagate button copies THAT iteration into all others — two-step
        confirm (button relabels, status line names the rewrite count), one
        undo step through the shipped propagation engine.
    -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- #601: the pinned row carries the tab's verb; the tab strip already names the tab. -->
        <Border Grid.Row="0" Classes="InspectorHeader">
            <Button Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" HorizontalAlignment="Right"
                    Content="{localization:Loc Inspector_Phrases_Refresh}"
                    Command="{Binding RefreshCommand}" />
        </Border>

        <!-- 0.42.2: was a bare warning-coloured TextBlock hand-tinting itself.
             Border.FieldIssue.Warn is the shared way to say "important, not
             fatal" — it owns the tint, the faint fill and the outline, so this
             now matches the Sound tab's field-level findings instead of being a
             second, slightly different warning look. -->
        <Border Grid.Row="1" Classes="FieldIssue Warn" Margin="{StaticResource GapChip}"
                IsVisible="{Binding StatusLine,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <PathIcon Data="{DynamicResource IconAlert}" />
                <TextBlock Text="{Binding StatusLine}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Classes="InspectorEmpty" IsVisible="{Binding !HasPhrases}">
            <!-- The class styles a leading PathIcon; without one this was the only
                 empty state in the inspector that was text alone. -->
            <PathIcon Data="{DynamicResource IconTechLinkNext}" />
            <TextBlock Text="{localization:Loc Inspector_Phrases_Empty}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding HasPhrases}">
            <ItemsControl ItemsSource="{Binding Phrases}" Margin="{StaticResource PaddingRow}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PhraseGroupRow">
                        <Border Padding="{StaticResource GapBottomSm}" Margin="{StaticResource GapBottomSm}"
                                BorderBrush="{DynamicResource FireBorderSeam}" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireTextBright}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="{StaticResource FontSizeSm}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Iterations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PhraseIterationRow">
                                            <Grid ColumnDefinitions="*,6,Auto">
                                                <Button Grid.Column="0" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Content="{Binding Label}"
                                                        Command="{Binding $parent[UserControl].((viewModels:PhrasesInspectorViewModel)DataContext).JumpToCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button AutomationProperties.Name="{localization:Loc Inspector_Phrases_Propagate}" Grid.Column="2" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact"
                                                        IsVisible="{Binding CanPropagate}"
                                                        Command="{Binding $parent[UserControl].((viewModels:PhrasesInspectorViewModel)DataContext).PropagateCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Panel>
                                                        <TextBlock Text="{localization:Loc Inspector_Phrases_Propagate}"
                                                                   IsVisible="{Binding !IsConfirming}" />
                                                        <TextBlock Text="{localization:Loc Inspector_Phrases_PropagateConfirm}"
                                                                   Foreground="{DynamicResource DangerColor}"
                                                                   FontWeight="SemiBold"
                                                                   IsVisible="{Binding IsConfirming}" />
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

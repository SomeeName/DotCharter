<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:local="using:DotCharter.UI.Views.Editor.Inspector"
             xmlns:converters="using:DotCharter.UI.Converters"
             xmlns:locSvc="clr-namespace:DotCharter.Localization;assembly=DotCharter.Localization"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.IssuesInspectorView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Issues tab in inspector design D: a ColumnFlowPanel of four cards, each its own view.
           * Findings (IssuesListView): the arrangement's findings, the easier-levels toggle, Refresh, auto-fix.
           * Fixes (IssuesDetailView): the finding last jumped to, Jump / Explain, the fix menu, the AI row.
           * Project (IssuesProjectView): the whole project's verdict and arrangements, the audio and export checks.
           * Review (IssuesReviewView): the Editor on Fire round trip.
         The Findings card keeps the left column; the others share a pager in a Small or short pane, and get
         columns in a wide one; Tiny pages all four (ColumnFlowPages). The pager IS the old section rail: its
         pick opens IssuesSectionsViewModel's section, and a section opened from outside (the status rail, Tools
         ▸ Chart quality report, the Editor on Fire export's "Show", the Sound tab) brings its card up
         (IssuesInspectorView.axaml.cs). A click on a finding brings up the Fixes card. Every card stays in the
         tree and is measured while paged away, so a page switch lays out nothing new. A page caption keeps
         what the rail entry said: the findings count, a dot on Project and Review when they need a look. -->
    <ctl:ColumnFlowPanel x:Name="IssuesCards" Margin="8,6">
        <ctl:ColumnFlowCard x:Name="IssuesFindingsCard" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ctl:ColumnFlowPanel.Title>
                <MultiBinding Converter="{x:Static converters:IssueRowConverters.PageTitle}">
                    <Binding Source="{x:Static locSvc:LocalizationService.Instance}" Path="[Inspector_Section_Findings]" />
                    <Binding Path="Issues.IssueCount" />
                </MultiBinding>
            </ctl:ColumnFlowPanel.Title>
            <local:IssuesListView x:Name="IssuesList" />
        </ctl:ColumnFlowCard>
        <ctl:ColumnFlowCard x:Name="IssuesFixesCard" ctl:ColumnFlowPanel.Title="{localization:Loc Issues_Card_Fixes}">
            <local:IssuesDetailView x:Name="IssuesDetail" />
        </ctl:ColumnFlowCard>
        <ctl:ColumnFlowCard x:Name="IssuesProjectCard">
            <ctl:ColumnFlowPanel.Title>
                <MultiBinding Converter="{x:Static converters:IssueRowConverters.PageTitle}">
                    <Binding Source="{x:Static locSvc:LocalizationService.Instance}" Path="[Issues_Card_Project]" />
                    <Binding Path="IssuesSections.ProjectNeedsAttention" />
                </MultiBinding>
            </ctl:ColumnFlowPanel.Title>
            <local:IssuesProjectView x:Name="IssuesProject" />
        </ctl:ColumnFlowCard>
        <ctl:ColumnFlowCard x:Name="IssuesReviewCard">
            <ctl:ColumnFlowPanel.Title>
                <MultiBinding Converter="{x:Static converters:IssueRowConverters.PageTitle}">
                    <Binding Source="{x:Static locSvc:LocalizationService.Instance}" Path="[Issues_Card_Review]" />
                    <Binding Path="IssuesSections.EditorOnFireDrops" />
                </MultiBinding>
            </ctl:ColumnFlowPanel.Title>
            <local:IssuesReviewView x:Name="IssuesReview" />
        </ctl:ColumnFlowCard>
    </ctl:ColumnFlowPanel>
</UserControl>

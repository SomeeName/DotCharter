<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:inspector="clr-namespace:DotCharter.UI.ViewModels.Editor.Inspector;assembly=DotCharter"
             xmlns:panels="clr-namespace:DotCharter.UI.ViewModels.Panels;assembly=DotCharter"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundLibraryTemplateView"
             x:DataType="panels:ChordTemplateEditorViewModel">
    <!-- The Library page's TEMPLATE card (#751 P5, design D): everything the old browse mode's chord panel edited, on
         the template the list picked (ChordTemplateEditorViewModel, a non-visual collaborator here): the template
         picker and New, the name (suggested names as pills), Arpeggio, No name, Nop, Pinned, the containing shapes,
         Fingerless and the per-string finger rows (the frets are read-only: browsing never reshapes), then Save
         fingering / Save & next / Next missing / Generate all. Each edit reaches the "Apply to" rung, as before. -->
    <StackPanel x:Name="SoundLibraryTemplate"
                Spacing="{StaticResource SpaceXs}">
        <Grid x:Name="ChordTemplatePickers" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceXs}">
            <TextBlock Grid.Row="0" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" Text="{localization:Loc ChordTemplate_Template}" VerticalAlignment="Center" />
            <ComboBox x:Name="SoundLibraryTemplatePicker" Grid.Row="0" Grid.Column="1" Classes="ColumnFlowField" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedDropdownTemplate}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_Template}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:TemplateListItem">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Row="0" Grid.Column="2" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="{localization:Loc ChordTemplate_New}" AutomationProperties.Name="{localization:Loc ChordTemplate_New}"
                    Command="{Binding CreateNewTemplateCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" Text="{localization:Loc ChordTemplate_Name}" VerticalAlignment="Center" />
            <ComboBox x:Name="ChordNameBox" Grid.Row="1" Grid.Column="1" Classes="ColumnFlowField" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Names.KnownChordNames}" SelectedItem="{Binding ChordName}" IsEnabled="{Binding !IsUnnamed}"
                      IsTextSearchEnabled="True" ToolTip.Tip="{localization:Loc ChordTemplate_NameTip}" AutomationProperties.Name="{localization:Loc ChordTemplate_Name}" />
            <CheckBox Grid.Row="1" Grid.Column="2" Content="{localization:Loc ChordTemplate_Arpeggio}" IsChecked="{Binding IsArpeggio}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_Arpeggio}" ToolTip.Tip="{localization:Loc ChordTemplate_ArpeggioTip}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Names.SuggestedChordNames}" IsVisible="{Binding Names.HasSuggestedChordNames}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceXs}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="{Binding .}" AutomationProperties.Name="{Binding .}"
                            Command="{Binding $parent[ItemsControl].((panels:ChordTemplateEditorViewModel)DataContext).ApplySuggestedChordNameCommand}" CommandParameter="{Binding .}"
                            ToolTip.Tip="{localization:Loc ChordTemplate_ApplySuggestedTip}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}">
            <CheckBox x:Name="NoNameToggle" Content="{localization:Loc ChordTemplate_NoName}" IsChecked="{Binding IsUnnamed}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_NoName}" ToolTip.Tip="{localization:Loc ChordTemplate_NoNameTip}" />
            <CheckBox x:Name="NopToggle" Content="{localization:Loc ChordTemplate_Nop}" IsChecked="{Binding IsNop}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_Nop}" ToolTip.Tip="{localization:Loc ChordTemplate_NopTip}" />
            <CheckBox x:Name="PinnedToggle" Content="{localization:Loc Inspector_GripPinned}" IsChecked="{Binding IsPinned}"
                      IsEnabled="{Binding CanTogglePin}" AutomationProperties.Name="{localization:Loc Inspector_GripPinned}"
                      ToolTip.Tip="{localization:Loc Inspector_GripPinned_Tip}" />
            <CheckBox x:Name="FingerlessToggle" Content="{localization:Loc ChordTemplate_Fingerless}" IsChecked="{Binding IsFingerless}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_Fingerless}" ToolTip.Tip="{localization:Loc ChordTemplate_FingerlessTip}" />
        </WrapPanel>
        <StackPanel IsVisible="{Binding Names.HasContainingShapes}" Spacing="{StaticResource SpaceXs}">
            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" Text="{localization:Loc ChordTemplate_ContainingShapes}" />
            <ItemsControl ItemsSource="{Binding Names.ContainingShapes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceXs}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:ShapeSuggestion">
                        <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((panels:ChordTemplateEditorViewModel)DataContext).ApplyContainingShapeCommand}" CommandParameter="{Binding .}"
                                ToolTip.Tip="{localization:Loc ChordTemplate_ContainingShapesTip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ItemsControl x:Name="StringRows" ItemsSource="{Binding DisplayStringInputs}">
            <!-- A Fingerless shape's strips are disabled: their segments must read as off, not as one more option. -->
            <ItemsControl.Styles>
                <Style Selector="ToggleButton.Seg:disabled">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="panels:StringFingeringInput">
                    <Grid Height="26" ColumnDefinitions="40,30,34,*">
                        <TextBlock Grid.Column="0" Text="{Binding StringName}" VerticalAlignment="Center" FontFamily="{StaticResource FireFontMono}"
                                   FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireTextMuted}"
                                   ToolTip.Tip="{localization:Loc ChordTemplate_StringNameTip}" />
                        <TextBlock Grid.Column="1" Text="{Binding FretText}" VerticalAlignment="Center" FontFamily="{StaticResource FireFontMono}"
                                   FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireTextPrimary}"
                                   ToolTip.Tip="{localization:Loc Inspector_Library_ReadOnlyShape}" />
                        <TextBlock Grid.Column="2" Text="{Binding PitchName}" VerticalAlignment="Center" FontFamily="{StaticResource FireFontMono}"
                                   FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireTextMuted}"
                                   ToolTip.Tip="{localization:Loc Inspector_SoundingPitchTip}" />
                        <StackPanel x:Name="FingerStrip" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    AutomationProperties.Name="{localization:Loc ChordTemplate_Finger}"
                                    IsEnabled="{Binding !$parent[ItemsControl].((panels:ChordTemplateEditorViewModel)DataContext).IsFingerless}" ToolTip.ShowOnDisabled="True"
                                    ToolTip.Tip="{Binding $parent[ItemsControl].((panels:ChordTemplateEditorViewModel)DataContext).FingerStripTip}">
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="—" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_None}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_None}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=''}" />
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="T" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_Thumb}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_Thumb}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=T}" />
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="1" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_Index}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_Index}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=1}" />
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="2" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_Middle}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_Middle}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=2}" />
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="3" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_Ring}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_Ring}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=3}" />
                            <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Width="24" MinWidth="24" Height="22" Padding="0"
                                          Content="4" AutomationProperties.Name="{localization:Loc ChordTemplate_Finger_Little}" ToolTip.Tip="{localization:Loc ChordTemplate_Finger_Little}"
                                          IsChecked="{Binding FingerText, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=4}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel x:Name="FingeringVerbs" ItemSpacing="{StaticResource SpaceXs}" LineSpacing="{StaticResource SpaceXs}">
            <Button x:Name="SoundLibrarySaveFingering" Grid.Row="0" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary" HorizontalAlignment="Stretch"
                    Content="{Binding SaveFingeringLabel}" AutomationProperties.Name="{Binding SaveFingeringLabel}"
                    Command="{Binding SaveFingerEditsCommand}" IsEnabled="{Binding CanSaveFingering}"
                    ToolTip.Tip="{localization:Loc ChordTemplate_Apply_SaveFingeringTip}" />
            <Button x:Name="SaveAndNextFingeringButton" Grid.Row="0" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc Keybind_SaveAndNextFingering}" AutomationProperties.Name="{localization:Loc Keybind_SaveAndNextFingering}"
                    Command="{Binding SaveAndNextFingeringCommand}" ToolTip.Tip="{localization:Loc ChordTemplate_SaveAndNextFingeringTip}" />
            <Button Grid.Row="1" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc ChordTemplate_NextMissingFingering}" AutomationProperties.Name="{localization:Loc ChordTemplate_NextMissingFingering}"
                    Command="{Binding SelectNextMissingFingeringCommand}" ToolTip.Tip="{localization:Loc ChordTemplate_NextMissingFingeringTip}" />
            <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc ChordTemplate_GenerateAllFingerings}" AutomationProperties.Name="{localization:Loc ChordTemplate_GenerateAllFingerings}"
                    Command="{Binding GenerateAllFingeringsCommand}" ToolTip.Tip="{localization:Loc ChordTemplate_GenerateAllFingeringsTip}" />
        </WrapPanel>
    </StackPanel>
</UserControl>

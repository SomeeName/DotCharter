<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:inspector="clr-namespace:DotCharter.UI.ViewModels.Editor.Inspector;assembly=DotCharter"
             xmlns:panels="clr-namespace:DotCharter.UI.ViewModels.Panels;assembly=DotCharter"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundBendsCurveView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Bends page's CURVE card (#751 P5, design D): a chord's string picker (a note bends itself), the curve
         (ctl:ColumnFlowBendPlot over the page's editor: 28 px handles, drag, click to add; Tab / arrows / Delete /
         Insert on the keyboard), Add point / Delete point and the selected point's readout. Every edit STAGES
         (Staged.Bends); the footer's Apply writes it. -->
    <Grid x:Name="SoundBendsCurve" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource SpaceXs}">
        <TextBlock x:Name="NoteBendsBody" Grid.Row="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" IsVisible="{Binding ShowNoteBends}"
                   Text="{localization:Loc Inspector_Bends_OnlyThisNote}" TextWrapping="Wrap" />
        <Grid x:Name="ChordBendsBody" Grid.Row="0" IsVisible="{Binding ShowChordBends}" ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource SpaceSm}">
            <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" Text="{localization:Loc Inspector_StringColon}" VerticalAlignment="Center" />
            <ComboBox x:Name="SoundBendsString" Grid.Column="1" Classes="ColumnFlowField" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ChordBendStringLabels}" SelectedIndex="{Binding ChordBendStringPosition}"
                      AutomationProperties.Name="{localization:Loc Inspector_StringColon}" ToolTip.Tip="{localization:Loc Inspector_BendStringTip}" />
        </Grid>
        <Border Grid.Row="1" Classes="FretboardWell" Height="120">
            <ctl:ColumnFlowBendPlot x:Name="SoundBendsPlot" Focusable="True" Editor="{Binding Staged.Bends.Editor}"
                                    Range="{Binding Staged.Bends.Range}"
                                    AutomationProperties.Name="{localization:Loc Inspector_Bends_Curve}" ToolTip.Tip="{localization:Loc Inspector_Bends_PlotTip}" />
        </Border>
        <WrapPanel Grid.Row="2" ItemSpacing="{StaticResource SpaceXs}" LineSpacing="{StaticResource SpaceXs}">
            <Button x:Name="SoundBendsAddPoint" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc Inspector_Bends_AddPoint}" AutomationProperties.Name="{localization:Loc Inspector_Bends_AddPoint}"
                    Command="{Binding Staged.Bends.AddPointCommand}" />
            <Button x:Name="SoundBendsDeletePoint" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc Inspector_Bends_DeletePoint}" AutomationProperties.Name="{localization:Loc Inspector_Bends_DeletePoint}"
                    Command="{Binding Staged.Bends.DeletePointCommand}" />
        </WrapPanel>
        <!-- The point values in mono; with no point yet, the "click the plot" hint as muted prose. -->
        <TextBlock x:Name="SoundBendsReadout" Grid.Row="3" Theme="{StaticResource ColumnFlowText}"
                   Classes.ColumnFlowStamp="{Binding Staged.Bends.HasPoints}" Classes.ColumnFlowMuted="{Binding !Staged.Bends.HasPoints}"
                   Text="{Binding Staged.Bends.Editor.PointReadout, FallbackValue=''}" TextWrapping="Wrap" />
    </Grid>
</UserControl>

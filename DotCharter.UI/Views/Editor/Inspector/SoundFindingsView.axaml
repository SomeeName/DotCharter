<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:inspector="clr-namespace:DotCharter.UI.ViewModels.Editor.Inspector;assembly=DotCharter"
             xmlns:panels="clr-namespace:DotCharter.UI.ViewModels.Panels;assembly=DotCharter"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundFindingsView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Findings page's LIST card (#601, #751 P5 design D): every problem on this selection, one row per PROBLEM
         (InspectorFieldIssue.Fold, #117) with the export consequence in its colour and tooltip; picking one shows it
         in the Detail card. Under them the way to the Issues tab and Fix all (the findings with a default repair).
         Classes bind directly and carry NO transition: an error must appear instantly. -->
    <StackPanel Spacing="{StaticResource SpaceXs}">
        <ListBox x:Name="SoundFindingsList" ItemsSource="{Binding SelectionFieldIssues}" SelectedItem="{Binding Findings.Picked}"
                 MaxHeight="150" Background="Transparent" IsVisible="{Binding HasSelectionIssues}"
                 AutomationProperties.Name="{localization:Loc Inspector_Section_Findings}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="inspector:InspectorFieldIssue">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Tooltip}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="inspector:InspectorFieldIssue">
                    <Border Classes="FieldIssue" Classes.Error="{Binding BlocksExport}" Classes.Warn="{Binding !BlocksExport}"
                            ToolTip.Tip="{Binding Tooltip}">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <PathIcon Grid.Column="0" Data="{DynamicResource IconAlert}" Margin="{StaticResource GapRightSm}" />
                            <TextBlock Grid.Column="1" Text="{Binding Code}" FontWeight="Bold" Margin="{StaticResource GapRightSm}" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_Findings_None}" IsVisible="{Binding !HasSelectionIssues}"
                   TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="{StaticResource SpaceXs}" LineSpacing="{StaticResource SpaceXs}">
            <Button x:Name="SoundFindingsOpenIssues" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                    Content="{localization:Loc Inspector_Findings_OpenInIssues}" AutomationProperties.Name="{localization:Loc Inspector_Findings_OpenInIssues}"
                    ToolTip.Tip="{localization:Loc Inspector_Issue_SelectionBadgeTip}" Command="{Binding ShowSelectionIssuesCommand}" />
            <Button x:Name="SoundFindingsFixAll" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary" HorizontalAlignment="Stretch"
                    Content="{Binding Findings.FixAllLabel}" AutomationProperties.Name="{Binding Findings.FixAllLabel}"
                    ToolTip.Tip="{localization:Loc Inspector_Findings_FixAllTip}" ToolTip.ShowOnDisabled="True"
                    Command="{Binding Findings.FixAllCommand}" IsEnabled="{Binding Findings.CanFixAll}" />
        </WrapPanel>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:vmInspector="using:DotCharter.UI.ViewModels.Editor.Inspector"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:inspector="clr-namespace:DotCharter.UI.Views.Editor.Inspector;assembly=DotCharter"
             xmlns:converters="using:DotCharter.UI.Converters"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.MixerInspectorView"
             x:DataType="viewModels:InspectorViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://DotCharter/Views/Editor/InspectorStyles.axaml" />
    </UserControl.Styles>
    <!-- The Mixer tab in inspector design D. A section strip (Stems / EQ / MIDI, captions only, the Note
         tab's quiet nav, MixerSectionsViewModel) over ONE section body at a time; each body is a
         ColumnFlowPanel of cards (the first keeps the left column, the others share a pager in a narrow
         pane and get columns in a wide one):
           * Stems (always offered, design D): Levels (the Playback source; a row per stem: fader, dB, mute, solo,
             reset; Reset levels, which asks first; without stems, why and "Separate stems"), Routing (waveform follows the mix, the guitar's Lead / Rhythm roles),
             Monitor (the fader positions; there is no live meter source, so it shows no meter).
           * EQ: EqModuleView, its own three cards.
           * MIDI: Instrument (the chart sound switch, the guitar / bass models and pickups), Routing (ChartSoundRoutingView:
             Sound source and Route instrument; the VST picker link, the offset), Play style.
         The master levels, pan, speed and pitch live in the toolbar's Mix and Tempo popovers (one home per
         mix control, `MixerLevelsInPopoversTests`). Every body stays in the tree, IsVisible-gated by its
         section; InspectorView.NestedPaneNames prewarms the hidden ones. Faders reset on a double-click
         (Controls/ResetOnDoubleClick) to the value the row's reset writes; every control writes through the
         existing view models and services, never on the audio thread. -->
    <Grid x:Name="MixerTabGrid" RowDefinitions="Auto,*">
        <Border x:Name="MixerSectionStrip" Grid.Row="0" Padding="8,2"
                Background="{DynamicResource FireSurfaceChrome}"
                BorderBrush="{DynamicResource FireBorder}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="MixerSectionEntries" Orientation="Horizontal" Spacing="3">
                <ToggleButton x:Name="MixerSectionStemsEntry" Theme="{StaticResource ColumnFlowNavToggle}" Classes="ColumnFlowNav"
                              IsChecked="{Binding MixerSections.IsStems, Mode=OneWay}"
                              Command="{Binding MixerSections.ChooseCommand}"
                              CommandParameter="{x:Static vmInspector:MixerSection.Stems}"
                              AutomationProperties.Name="{localization:Loc Inspector_Stems}">
                    <TextBlock Text="{localization:Loc Inspector_Stems}" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton x:Name="MixerSectionEqEntry" Theme="{StaticResource ColumnFlowNavToggle}" Classes="ColumnFlowNav"
                              IsChecked="{Binding MixerSections.IsEq, Mode=OneWay}"
                              Command="{Binding MixerSections.ChooseCommand}"
                              CommandParameter="{x:Static vmInspector:MixerSection.Eq}"
                              AutomationProperties.Name="{localization:Loc Mixer_Section_Eq}"
                              ToolTip.Tip="{localization:Loc Inspector_EqFilters}">
                    <TextBlock Text="{localization:Loc Mixer_Section_Eq}" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton x:Name="MixerSectionMidiEntry" Theme="{StaticResource ColumnFlowNavToggle}" Classes="ColumnFlowNav"
                              IsChecked="{Binding MixerSections.IsMidi, Mode=OneWay}"
                              Command="{Binding MixerSections.ChooseCommand}"
                              CommandParameter="{x:Static vmInspector:MixerSection.Midi}"
                              AutomationProperties.Name="{localization:Loc Inspector_MidiSynth}">
                    <TextBlock Text="{localization:Loc Inspector_MidiSynth}" VerticalAlignment="Center" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="8,6">
            <!-- ── Stems ── -->
            <ctl:ColumnFlowPanel x:Name="MixerStemsBody" IsVisible="{Binding MixerSections.IsStems}">
                <ctl:ColumnFlowCard x:Name="StemLevelsCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Levels}">
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Stems_Title}" />
                        <!-- design D: what the song plays from; the stem strips stay below it either way -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource FireSpaceSm}">
                            <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Mixer_Playback_Source}" />
                            <ComboBox Grid.Column="1" x:Name="StemPlaybackSource" Classes="ColumnFlowField"
                                      AutomationProperties.Name="{localization:Loc Mixer_Playback_Source}"
                                      ToolTip.Tip="{localization:Loc Mixer_Playback_SourceTip}"
                                      IsEnabled="{Binding StemMixer.HasStems}"
                                      ItemsSource="{Binding StemMixer.PlaybackChoices}"
                                      SelectedItem="{Binding StemMixer.PlaybackChoice, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock x:Name="StemOriginalMixNote" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                                   IsVisible="{Binding StemMixer.PlaysOriginalMix}" Text="{localization:Loc Mixer_Playback_OriginalNote}" />
                        <!-- no stems yet: why, and the shell's separation (it loads the song's .dcstems archive first, never regenerates) -->
                        <StackPanel x:Name="StemNoStemsState" Spacing="{StaticResource FireSpaceXs}" IsVisible="{Binding !StemMixer.HasStems}">
                            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap" Text="{localization:Loc Mixer_Playback_NoStemsNote}" />
                            <Button x:Name="StemSeparateButton" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary"
                                    HorizontalAlignment="Stretch"
                                    Content="{localization:Loc Mixer_Playback_Separate}"
                                    AutomationProperties.Name="{localization:Loc Mixer_Playback_Separate}"
                                    ToolTip.Tip="{localization:Loc Mixer_Playback_SeparateTip}"
                                    Command="{Binding StemSeparation.SeparateStemsCommand}" />
                        </StackPanel>
                        <ItemsControl x:Name="StemRows" ItemsSource="{Binding StemMixer.Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StemTrackViewModel">
                                    <Grid ColumnDefinitions="56,*,44,Auto" ColumnSpacing="{StaticResource FireSpaceXs}" Margin="0,0,0,3">
                                        <!-- The name carries the stem's identity colour, as the fader fill does. -->
                                        <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowBody"
                                                   Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{x:Static converters:StemIdentityBrushConverter.Instance}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="IsMasterMix" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <!-- The pair (Name, IsMasterMix) keys the colour: the master's display name is localized. -->
                                        <Slider Grid.Column="1" Classes="MixerSlider" Minimum="0" Maximum="2.0" AutomationProperties.Name="{Binding DisplayName}"
                                                Value="{Binding VolumeLinear, Mode=TwoWay}"
                                                ctl:ResetOnDoubleClick.DefaultValue="{Binding DefaultVolumeLinear}"
                                                ToolTip.Tip="{localization:Loc Inspector_DoubleClickReset}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True">
                                            <Slider.Foreground>
                                                <MultiBinding Converter="{x:Static converters:StemIdentityBrushConverter.Instance}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="IsMasterMix" />
                                                </MultiBinding>
                                            </Slider.Foreground>
                                        </Slider>
                                        <TextBlock Grid.Column="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue" TextAlignment="Right"
                                                   Text="{Binding VolumeDbLabel}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource FireSpaceXxs}" VerticalAlignment="Center">
                                            <ToggleButton Content="M" Classes="MuteBtn"
                                                          AutomationProperties.Name="{localization:Loc Inspector_Mute}"
                                                          ToolTip.Tip="{localization:Loc Inspector_Mute}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                                            <ToggleButton Content="S" Classes="SoloBtn"
                                                          AutomationProperties.Name="{localization:Loc Inspector_Solo}"
                                                          ToolTip.Tip="{localization:Loc Inspector_Solo}"
                                                          IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                                          IsEnabled="{Binding !IsMasterMix}" />
                                            <Button x:Name="StemReset" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                                    Width="28" Padding="0"
                                                    AutomationProperties.Name="{localization:Loc Mixer_Stem_Reset}"
                                                    ToolTip.Tip="{localization:Loc Mixer_Stem_ResetTip}"
                                                    Command="{Binding ResetLevelCommand}">
                                                <PathIcon Data="{DynamicResource IconUndo}" Width="11" Height="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="StemResetLevels" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Left"
                                Content="{localization:Loc Mixer_Stems_ResetLevels}"
                                AutomationProperties.Name="{localization:Loc Mixer_Stems_ResetLevels}"
                                ToolTip.Tip="{localization:Loc Mixer_Stems_ResetLevelsTip}"
                                IsVisible="{Binding StemMixer.HasStems}"
                                Command="{Binding StemMixer.ResetLevelsCommand}" />
                        <inspector:InspectorConfirmRow x:Name="StemResetLevelsConfirm" DataContext="{Binding StemMixer.ResetLevelsConfirm}" />
                    </StackPanel>
                </ctl:ColumnFlowCard>
                <ctl:ColumnFlowCard x:Name="StemRoutingCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Routing}">
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Stems_RolesTitle}" />
                        <!-- Draw the timeline waveform from what the MIXER plays rather than from the audio file:
                             a property of the stem set, so it sits above the roles it changes. -->
                        <ToggleButton x:Name="WaveformFollowsMixToggle" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding StemMixer.WaveformFollowsMix}"
                                      Content="{localization:Loc Mixer_WaveformFollowsMix}"
                                      ToolTip.Tip="{localization:Loc Mixer_WaveformFollowsMix_Tip}"
                                      AutomationProperties.Name="{localization:Loc Mixer_WaveformFollowsMix}" />
                        <!-- design D: the song's waveform in a short strip, captioned with what it shows -->
                        <TextBlock x:Name="StemWaveformCaption" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                                   Text="{Binding StemMixer.WaveformCaption}" />
                        <ctl:ColumnFlowStemWaveform x:Name="StemWaveform" Samples="{Binding StemMixer.Waveform}" />
                        <!-- #260: the guitar stem as Lead (centre) / Rhythm (sides). -->
                        <inspector:GuitarRolesView x:Name="GuitarRoles" DataContext="{Binding StemMixer.GuitarRoles}" />
                    </StackPanel>
                </ctl:ColumnFlowCard>
                <ctl:ColumnFlowCard x:Name="StemMonitorCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Monitor}">
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Monitor_Title}" />
                        <!-- Fader-derived only: the engine has no meter source, and a fake meter would lie. -->
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap" Text="{localization:Loc Mixer_Monitor_Note}" />
                        <ItemsControl x:Name="StemMonitorRows" ItemsSource="{Binding StemMixer.Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StemTrackViewModel">
                                    <Grid ColumnDefinitions="56,*,44" ColumnSpacing="{StaticResource FireSpaceXs}" Margin="0,0,0,3"
                                          Opacity="{Binding IsMuted, Converter={x:Static converters:BoolConverters.ToDimmedOpacity}}">
                                        <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowBody" Text="{Binding DisplayName}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding VolumeLinear}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding DisplayName}">
                                            <ProgressBar.Foreground>
                                                <MultiBinding Converter="{x:Static converters:StemIdentityBrushConverter.Instance}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="IsMasterMix" />
                                                </MultiBinding>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                        <TextBlock Grid.Column="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue" TextAlignment="Right"
                                                   Text="{Binding VolumeDbLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ColumnFlowCard>
            </ctl:ColumnFlowPanel>

            <!-- ── EQ: its own three cards ── -->
            <Panel x:Name="MixerEqBody" IsVisible="{Binding MixerSections.IsEq}">
                <inspector:EqModuleView x:Name="MixerEq" DataContext="{Binding Transport.Eq}" />
            </Panel>

            <!-- ── MIDI ── -->
            <ctl:ColumnFlowPanel x:Name="MixerMidiBody" IsVisible="{Binding MixerSections.IsMidi}">
                <ctl:ColumnFlowCard x:Name="MidiInstrumentCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Instrument}">
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Midi_Title}" />
                        <!-- #138: ONE switch plays the chart (Tools ▸ MIDI instrument ▸ Out is the same property). -->
                        <ToggleButton x:Name="ChartSynthToggle" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding Transport.MidiEnabled}"
                                      IsEnabled="{Binding Transport.CanPlayChart}"
                                      Content="{localization:Loc Mixer_ChartSynth}"
                                      ToolTip.Tip="{localization:Loc Mixer_ChartSynth_Tip}"
                                      AutomationProperties.Name="{localization:Loc Mixer_ChartSynth}" />
                        <!-- #574: no engine, nothing sounds: the switch is off and says why. -->
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FireWarning}"
                                   Text="{localization:Loc Mixer_ChartSynth_Unavailable}"
                                   IsVisible="{Binding !Transport.CanPlayChart}" />
                        <!-- #50: which guitar / bass it sounds like, and its pickups. -->
                        <inspector:MidiInstrumentCardView x:Name="ChartSynthInstrument" DataContext="{Binding Transport.ChartSynthInstrument}" />
                    </StackPanel>
                </ctl:ColumnFlowCard>
                <ctl:ColumnFlowCard x:Name="MidiRoutingCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Routing}">
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Midi_Routing}" />
                        <!-- design D: without the synth nothing here applies; the card stays, disabled, and says why. -->
                        <TextBlock x:Name="MidiRoutingUnavailable" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FireWarning}"
                                   Text="{localization:Loc Mixer_Midi_UnavailableReason}"
                                   IsVisible="{Binding !Transport.CanPlayChart}" />
                        <StackPanel x:Name="MidiRoutingRows" Spacing="{StaticResource FireSpaceXs}" IsEnabled="{Binding Transport.CanPlayChart}">
                        <!-- design D: Sound source and Route instrument, over Transport.SoundRouting. -->
                        <inspector:ChartSoundRoutingView x:Name="ChartSoundRouting" DataContext="{Binding Transport.SoundRouting}" />
                        <!-- The VST instrument picker lives in the toolbar's Practice tools popover (one picker). -->
                        <Button x:Name="ChartSynthVstLink" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Left"
                                Content="{localization:Loc Mixer_ChartSynth_VstLink}"
                                ToolTip.Tip="{localization:Loc Mixer_ChartSynth_VstLink_Tip}"
                                AutomationProperties.Name="{localization:Loc Mixer_ChartSynth_VstLink}"
                                Click="OpenVstInstrumentPicker" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource FireSpaceSm}">
                            <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_Offset}" />
                            <NumericUpDown x:Name="MidiOffsetField" Grid.Column="1" Classes="ColumnFlowField"
                                           ShowButtonSpinner="False"
                                           AutomationProperties.Name="{localization:Loc Inspector_Offset}"
                                           HorizontalAlignment="Stretch"
                                           Minimum="-500" Maximum="500" Increment="5"
                                           FormatString="0 ms"
                                           Value="{Binding Transport.MidiOffsetMs}"
                                           ToolTip.Tip="{localization:Loc Inspector_MidiOffsetTip}" />
                        </Grid>
                        <Button x:Name="MidiResetRouting" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch"
                                Content="{localization:Loc Mixer_Midi_ResetRouting}"
                                AutomationProperties.Name="{localization:Loc Mixer_Midi_ResetRouting}"
                                ToolTip.Tip="{localization:Loc Mixer_Midi_ResetRoutingTip}"
                                Command="{Binding Transport.ResetRoutingCommand}" />
                        </StackPanel>
                        <inspector:InspectorConfirmRow x:Name="MidiResetRoutingConfirm" DataContext="{Binding Transport.ResetRoutingConfirm}" />
                    </StackPanel>
                </ctl:ColumnFlowCard>
                <ctl:ColumnFlowCard x:Name="MidiPlayStyleCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_PlayStyle}">
                    <!-- #160: how the synth plays this song (saved with the project); without the synth, disabled with the reason. -->
                    <StackPanel Spacing="{StaticResource FireSpaceXs}">
                        <TextBlock x:Name="MidiPlayStyleUnavailable" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FireWarning}"
                                   Text="{localization:Loc Mixer_Midi_UnavailableReason}"
                                   IsVisible="{Binding !Transport.CanPlayChart}" />
                        <Panel x:Name="MidiPlayStyleRows" IsEnabled="{Binding Transport.CanPlayChart}">
                            <inspector:ChartSynthPlayStyleView x:Name="ChartSynthPlayStyle" DataContext="{Binding SynthPlayStyle}" />
                        </Panel>
                    </StackPanel>
                </ctl:ColumnFlowCard>
            </ctl:ColumnFlowPanel>
        </Panel>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:inspector="clr-namespace:DotCharter.UI.ViewModels.Editor.Inspector;assembly=DotCharter"
             xmlns:panels="clr-namespace:DotCharter.UI.ViewModels.Panels;assembly=DotCharter"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundTaskView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Task page's FIX THE NEXT SOUND card (#601, #751 P5 design D). Nothing selected is most of a charting
         session, so it leads with the NEXT thing that needs work (SoundNextTaskViewModel), then the three triage rows
         with their counts (each the queue's own triage: set the filter, jump to its first match; a row with nothing
         to do is disabled, never hidden), then Fix next. Where the pen writes is the At the playhead card's. -->
    <StackPanel x:Name="SoundTaskCard" Spacing="{StaticResource SpaceXs}">
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{Binding NextTask.Kicker}" />
        <TextBlock x:Name="SoundTaskTitle" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{Binding NextTask.Title}" TextWrapping="Wrap" />
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{Binding NextTask.Detail}" TextWrapping="Wrap" />
        <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{localization:Loc Inspector_Empty_Tile_Fingerings}" ToolTip.Tip="{localization:Loc Inspector_Queue_Filter_MissingFingering}" ToolTip.ShowOnDisabled="True"
                Command="{Binding NextTask.TriageCommand}" CommandParameter="{x:Static viewModels:SoundQueueFilter.MissingFingering}"
                IsEnabled="{Binding NextTask.HasFingeringTask}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <TextBlock Grid.Column="0" Text="{localization:Loc Inspector_Empty_Tile_Fingerings}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Queue.MissingFingeringCount}" FontFamily="{StaticResource FireFontMono}"
                           Foreground="{DynamicResource FireWarning}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{localization:Loc Inspector_Empty_Tile_Unnamed}" ToolTip.Tip="{localization:Loc Inspector_Queue_Filter_UnnamedChord}" ToolTip.ShowOnDisabled="True"
                Command="{Binding NextTask.TriageCommand}" CommandParameter="{x:Static viewModels:SoundQueueFilter.UnnamedChord}"
                IsEnabled="{Binding NextTask.HasUnnamedTask}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <TextBlock Grid.Column="0" Text="{localization:Loc Inspector_Empty_Tile_Unnamed}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Queue.UnnamedChordCount}" FontFamily="{StaticResource FireFontMono}"
                           Foreground="{DynamicResource FireWarning}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{localization:Loc Inspector_Empty_Tile_Blockers}" ToolTip.Tip="{Binding Queue.BlocksExportTileTip}" ToolTip.ShowOnDisabled="True"
                Command="{Binding NextTask.TriageCommand}" CommandParameter="{x:Static viewModels:SoundQueueFilter.BlocksExport}"
                IsEnabled="{Binding NextTask.HasBlockers}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <TextBlock Grid.Column="0" Text="{localization:Loc Inspector_Empty_Tile_Blockers}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Queue.BlocksExportCount}" FontFamily="{StaticResource FireFontMono}"
                           Foreground="{DynamicResource FireDanger}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button x:Name="SoundTaskFixNext" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary" HorizontalAlignment="Left"
                Content="{localization:Loc Inspector_Task_FixNext}" AutomationProperties.Name="{localization:Loc Inspector_Task_FixNext}"
                ToolTip.Tip="{localization:Loc Inspector_Task_FixNextTip}" ToolTip.ShowOnDisabled="True"
                Command="{Binding NextTask.FixNextCommand}" IsEnabled="{Binding NextTask.HasTask}" />
    </StackPanel>
</UserControl>

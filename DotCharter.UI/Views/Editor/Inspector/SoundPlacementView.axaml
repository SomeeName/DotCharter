<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundPlacementView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Placement page's POSITION card (#751 P4, design D's "Placement"): string, fret, sustain and slide
         target of one note, each STAGED (Staged.Placement) and written by the footer's Apply; the sounding pitch
         follows the staged string and fret. String is a choice named like the lane gutter ("E (6)"), its index
         the model index; Sustain is grid-relative ("1/8"), commits on Enter or focus loss, and its spinner is one
         grid step. -->
    <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                   Text="{localization:Loc Inspector_Placement}" />
        <Grid x:Name="NotePlacementFields" ColumnDefinitions="*,1.3*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceXs}">
            <TextBlock Grid.Row="0" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_String}" ToolTip.Tip="{localization:Loc Inspector_StringTip}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="NoteStringPicker" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Staged.Placement.StringLabels}"
                      SelectedIndex="{Binding Staged.Placement.StringIndex}"
                      AutomationProperties.Name="{localization:Loc Inspector_String}"
                      ToolTip.Tip="{localization:Loc Inspector_StringTip}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_Fret}" ToolTip.Tip="{localization:Loc Inspector_FretTip}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NoteFretField" Classes="InspectorNumber"
                           Value="{Binding Staged.Placement.Fret}" Minimum="0" Maximum="24"
                           AutomationProperties.Name="{localization:Loc Inspector_Fret}"
                           ToolTip.Tip="{localization:Loc Inspector_FretTip}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_NoteLength}" ToolTip.Tip="{localization:Loc Inspector_NoteLengthTip}" />
            <ButtonSpinner Grid.Row="2" Grid.Column="1" Classes="InspectorNumber" x:Name="NoteLengthSpinner"
                           Spin="OnNoteLengthSpin"
                           AutomationProperties.Name="{localization:Loc Inspector_NoteLength}"
                           ToolTip.Tip="{localization:Loc Inspector_NoteLengthTip}">
                <TextBox AutomationProperties.Name="{localization:Loc Inspector_NoteLength}"
                         Text="{Binding Staged.Placement.SustainText, UpdateSourceTrigger=LostFocus}" />
            </ButtonSpinner>

            <TextBlock Grid.Row="3" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_SlideTo}" ToolTip.Tip="{localization:Loc Inspector_SlideToTip}" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NoteSlideField" Classes="InspectorNumber"
                           Value="{Binding Staged.Placement.SlideTo}" Minimum="0" Maximum="24"
                           AutomationProperties.Name="{localization:Loc Inspector_SlideTo}"
                           ToolTip.Tip="{localization:Loc Inspector_SlideToFretTip}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_SoundingPitch}" ToolTip.Tip="{localization:Loc Inspector_SoundingPitchTip}" />
            <StackPanel Grid.Row="4" Grid.Column="1" x:Name="NotePlacementReadout" Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSm}" HorizontalAlignment="Right">
                <TextBlock x:Name="NotePitchReadout" Text="{Binding Staged.Placement.PitchName}"
                           IsVisible="{Binding Staged.Placement.HasPitch}"
                           FontFamily="{StaticResource FireFontMono}" FontWeight="SemiBold"
                           Foreground="{DynamicResource FireTextBright}" VerticalAlignment="Center"
                           ToolTip.Tip="{localization:Loc Inspector_SoundingPitchTip}" />
                <TextBlock Text="{Binding Staged.Placement.SustainLabel}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FireFontMono}" FontSize="{StaticResource FireSizeXs}"
                           Foreground="{DynamicResource FireTextMuted}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>

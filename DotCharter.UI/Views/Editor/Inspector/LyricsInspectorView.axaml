<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.LyricsInspectorView"
             x:DataType="viewModels:LyricsInspectorViewModel"
             x:CompileBindings="True">
    <!--
        The Lyrics tab, laid out as inspector design D: a ColumnFlowPanel of four cards over a pinned footer.
        * LYRIC REVIEW (pinned head and foot, the rows scroll between them): every syllable of the active vocal
          track or only those auto-sync flagged (LyricSyllableList: a row picked is the editor's selected
          syllable and the playhead moves there), how many are left to review, Previous / Next review, Mark
          reviewed and Close gaps.
        * SYLLABLE: the selected syllable — its text (a DRAFT until Enter or lost focus commits it: a trailing
          '-' joins lines), its sung note and Pitched, Word part, Phrase end, Previous / Next syllable, why it is
          flagged, Delete.
        * RAW TEXT: the text the tap queue and auto-sync both read; Auto-sync, Reset, Tap at playhead
          (Ctrl+Space) and, while the queue is armed, the next syllable.
        * FILES: LRC and UltraStar import / export.
        The footer is pinned over every card: the tap status (it must stay in view while a charter taps) and
        Apply, which loads the raw text into the tap queue.
    -->
    <Grid RowDefinitions="*,Auto">
        <ctl:ColumnFlowPanel x:Name="LyricsCards" Grid.Row="0" Margin="8,6">
            <!-- ── the review list ── -->
            <Border x:Name="LyricsListCard" Theme="{StaticResource ColumnFlowFrame}" Classes="ColumnFlowFrame"
                    ctl:ColumnFlowPanel.Title="{localization:Loc Inspector_Lyrics_ReviewList}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{StaticResource FireSpaceXs}">
                    <TextBlock Grid.Row="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc Inspector_Lyrics_ReviewList}" />
                    <ComboBox Grid.Row="1" x:Name="LyricsFilter" Classes="ColumnFlowField"
                              AutomationProperties.Name="{localization:Loc Inspector_Lyrics_Filter}"
                              ToolTip.Tip="{localization:Loc Inspector_Lyrics_Filter}"
                              SelectedIndex="{Binding Syllables.FilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{localization:Loc Inspector_Lyrics_Filter_All}" />
                        <ComboBoxItem Content="{localization:Loc Inspector_Lyrics_Filter_Review}" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" x:Name="LyricReviewCount" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                               TextWrapping="Wrap" Text="{Binding ReviewCountText}" />
                    <TextBlock Grid.Row="3" x:Name="LyricsListEmpty" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                               VerticalAlignment="Top" TextWrapping="Wrap" IsVisible="{Binding !Syllables.HasRows}"
                               Text="{localization:Loc Inspector_Lyrics_ListEmpty}" />
                    <ListBox Grid.Row="3" x:Name="LyricsList"
                             AutomationProperties.Name="{localization:Loc Inspector_Lyrics_ReviewList}"
                             Background="Transparent" BorderThickness="0" IsVisible="{Binding Syllables.HasRows}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Syllables.Rows}"
                             SelectedItem="{Binding Syllables.SelectedRow, Mode=TwoWay}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:LyricSyllableRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}">
                                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowStamp"
                                               Text="{Binding TimeLabel}" />
                                    <TextBlock Grid.Column="1" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowBody"
                                               Text="{Binding Text}" />
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{DynamicResource FireWarning}" IsVisible="{Binding NeedsReview}"
                                             ToolTip.Tip="{localization:Loc Inspector_Lyrics_Filter_Review}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource FireSpaceXs}" RowSpacing="{StaticResource FireSpaceXs}">
                        <Button Grid.Row="0" Grid.Column="0" x:Name="PreviousLyricReview" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_PreviousReview}"
                                Command="{Binding PreviousReviewCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_PreviousReview}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="NextLyricReview" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_NextReview}"
                                Command="{Binding NextReviewCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_NextReview}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" x:Name="MarkLyricReviewed" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_MarkReviewed}"
                                Command="{Binding MarkReviewedCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_MarkReviewed}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" x:Name="LyricsCloseGaps" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc History_CloseLyricGaps}"
                                Command="{Binding CloseGapsCommand}">
                            <TextBlock Text="{localization:Loc History_CloseLyricGaps}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── the selected syllable ── -->
            <ctl:ColumnFlowCard x:Name="LyricsSyllableCard" ctl:ColumnFlowPanel.Title="{localization:Loc Inspector_Lyrics_Syllable}">
                <Panel>
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                               VerticalAlignment="Top" IsVisible="{Binding !HasSelectedLyric}"
                               Text="{localization:Loc Inspector_Lyrics_NoSyllable}" />
                    <StackPanel x:Name="LyricsSyllableBody" Spacing="{StaticResource FireSpaceXs}" IsVisible="{Binding HasSelectedLyric}">
                        <!-- The text is a DRAFT until Enter or lost focus commits it (code-behind):
                             a trailing '-' joins lines, so it must not act per keystroke. -->
                        <TextBox x:Name="LyricsSelectedTextBox" Classes="ColumnFlowField"
                                 Text="{Binding SelectedLyricText, Mode=TwoWay}"
                                 AutomationProperties.Name="{localization:Loc Inspector_Lyrics_Selected}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CommitSelectedLyricTextCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <!-- the sung note on its own row: the number box needs its width to show three digits -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource FireSpaceXs}">
                            <NumericUpDown Grid.Column="0" x:Name="LyricsPitch" Value="{Binding SelectedLyricNote, Mode=TwoWay}"
                                           AutomationProperties.Name="{localization:Loc Inspector_Lyrics_Pitch}"
                                           ToolTip.Tip="{localization:Loc Inspector_Lyrics_Pitch}"
                                           IsEnabled="{Binding SelectedLyricHasPitch}" MinHeight="28"
                                           Minimum="0" Maximum="127" Increment="1"
                                           FormatString="0" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Column="1" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue"
                                       MinWidth="32" VerticalAlignment="Center" Text="{Binding SelectedLyricNoteName}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="{StaticResource FireSpaceXs}" RowSpacing="{StaticResource FireSpaceXs}">
                            <ToggleButton Grid.Row="0" Grid.Column="0" x:Name="LyricsPitched" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding SelectedLyricHasPitch, Mode=TwoWay}"
                                          AutomationProperties.Name="{localization:Loc Inspector_Lyrics_HasPitch}"
                                          ToolTip.Tip="{localization:Loc Inspector_Lyrics_HasPitch}">
                                <TextBlock Text="{localization:Loc Inspector_Lyrics_Pitched}" TextTrimming="CharacterEllipsis" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="0" Grid.Column="1" x:Name="LyricsPhraseEnd" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding SelectedLyricIsPhraseEnd, Mode=TwoWay}"
                                          AutomationProperties.Name="{localization:Loc Inspector_PhraseEnd}"
                                          ToolTip.Tip="{localization:Loc Inspector_Lyrics_PhraseEndTip}">
                                <TextBlock Text="{localization:Loc Inspector_PhraseEnd}" TextTrimming="CharacterEllipsis" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LyricsWordPart" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding SelectedLyricIsWordPart, Mode=TwoWay}"
                                          AutomationProperties.Name="{localization:Loc Inspector_Lyrics_WordPart}">
                                <TextBlock Text="{localization:Loc Inspector_Lyrics_WordPart}" TextTrimming="CharacterEllipsis" />
                            </ToggleButton>
                            <Button Grid.Row="2" Grid.Column="0" x:Name="LyricsPreviousSyllable" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{localization:Loc Inspector_Lyrics_PreviousSyllable}"
                                    Command="{Binding Syllables.PreviousCommand}">
                                <TextBlock Text="{localization:Loc Inspector_Lyrics_PreviousSyllable}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" x:Name="LyricsNextSyllable" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{localization:Loc Inspector_Lyrics_NextSyllable}"
                                    Command="{Binding Syllables.NextCommand}">
                                <TextBlock Text="{localization:Loc Inspector_Lyrics_NextSyllable}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </Grid>
                        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                                   Text="{Binding SelectedLyricReviewDetails}" />
                        <Button x:Name="LyricsSelectedDelete" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{localization:Loc Action_Delete}"
                                Command="{Binding DeleteSelectedLyricCommand}">
                            <TextBlock Text="{localization:Loc Action_Delete}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                </Panel>
            </ctl:ColumnFlowCard>

            <!-- ── the raw text: what the tap queue and auto-sync read ── -->
            <ctl:ColumnFlowCard x:Name="LyricsRawCard" ctl:ColumnFlowPanel.Title="{localization:Loc Inspector_Lyrics_RawTab}">
                <StackPanel x:Name="LyricsRawBody" Spacing="{StaticResource FireSpaceXs}">
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc Inspector_Lyrics_RawSection}" ToolTip.Tip="{localization:Loc Inspector_Lyrics_RawHelp}" />
                    <TextBox x:Name="LyricsRawBox" Text="{Binding RawLyrics, Mode=TwoWay}"
                             AutomationProperties.Name="{localization:Loc Inspector_Lyrics_RawSection}"
                             ToolTip.Tip="{localization:Loc Inspector_Lyrics_RawHelp}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="72" MaxHeight="240" VerticalContentAlignment="Top"
                             FontSize="{StaticResource FireSizeXs}"
                             FontFamily="{StaticResource FireFontMono}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource FireSpaceXs}" RowSpacing="{StaticResource FireSpaceXs}">
                        <!-- Same box, same format as Apply — this places every syllable by
                             listening to the song instead of arming the Ctrl+Space tap queue. -->
                        <Button Grid.Row="0" Grid.Column="0" x:Name="LyricsAutoSync" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_AutoSync}"
                                ToolTip.Tip="{localization:Loc Inspector_Lyrics_AutoSyncHelp}"
                                Command="{Binding AutoSyncCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_AutoSync}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="LyricsReset" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_Reset}"
                                Command="{Binding ResetCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_Reset}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LyricsTap" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{localization:Loc Inspector_Lyrics_TapAtPlayhead}"
                                ToolTip.Tip="{localization:Loc Inspector_Lyrics_TapHint}"
                                Command="{Binding TapAtPlayheadCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_TapAtPlayhead}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsAutoSyncing}" />
                    <TextBlock IsVisible="{Binding IsArmed}" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FireAccentBright}">
                        <Run Text="▶ " />
                        <Run Text="{Binding NextPreview}" />
                    </TextBlock>
                    <TextBlock IsVisible="{Binding IsArmed}" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                               TextWrapping="Wrap" Text="{localization:Loc Inspector_Lyrics_TapHint}" />
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                               Text="{localization:Loc Inspector_Lyrics_AutoSyncHelp}" />
                </StackPanel>
            </ctl:ColumnFlowCard>

            <!-- ── import / export ── -->
            <ctl:ColumnFlowCard x:Name="LyricsFilesCard" ctl:ColumnFlowPanel.Title="{localization:Loc Inspector_Lyrics_FilesTab}">
                <StackPanel x:Name="LyricsTransferBody" Spacing="{StaticResource FireSpaceXs}">
                    <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc Inspector_Lyrics_TransferSection}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="{StaticResource FireSpaceXs}" RowSpacing="{StaticResource FireSpaceXs}">
                        <Button Grid.Row="0" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="{localization:Loc Inspector_Lyrics_ImportLrc}"
                                Command="{Binding ImportLrcCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_ImportLrc}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="{localization:Loc Inspector_Lyrics_ExportLrc}"
                                Command="{Binding ExportLrcCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_ExportLrc}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="{localization:Loc Inspector_Lyrics_ImportUltraStar}"
                                Command="{Binding ImportUltraStarCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_ImportUltraStar}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="{localization:Loc Inspector_Lyrics_ExportUltraStar}"
                                Command="{Binding ExportUltraStarCommand}">
                            <TextBlock Text="{localization:Loc Inspector_Lyrics_ExportUltraStar}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ctl:ColumnFlowCard>
        </ctl:ColumnFlowPanel>

        <!-- ── the pinned footer: the tap status and Apply (loads the raw text into the tap queue) ── -->
        <Border Grid.Row="1" x:Name="LyricsFooter"
                Background="{DynamicResource FireSurfaceFooter}"
                BorderBrush="{DynamicResource FireBorderSeam}" BorderThickness="0,1,0,0"
                Padding="{StaticResource FirePadTag}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource FireSpaceXs}">
                <TextBlock Grid.Column="0" x:Name="LyricsStatusText" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted"
                           TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" />
                <Button Grid.Column="1" x:Name="LyricsApply" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton ColumnFlowPrimary"
                        AutomationProperties.Name="{localization:Loc Inspector_Lyrics_Apply}"
                        ToolTip.Tip="{localization:Loc Inspector_Lyrics_RawHelp}"
                        Command="{Binding ApplyCommand}">
                    <TextBlock Text="{localization:Loc Inspector_Lyrics_Apply}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:inspectorVm="using:DotCharter.UI.ViewModels.Editor.Inspector"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundChordTechniqueView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Technique page of a chord, its STRINGS card (#751 P4, design D): one string at a time (its key lit,
         string 1 = the highest), its techniques STAGED per string (Staged.ChordTechnique) and written by the
         footer's Apply on the same string of every chord the "Apply to" ladder reaches. A string the chord does
         not play, or one the string-edit mask leaves out, takes no edit. "Copy to N" stages the edited string's
         techniques, its Ignore and its slide (as an interval) on every other played string in the mask. -->
    <UserControl.Resources>
        <!-- Closed, a picker shows its choice on up to two lines: two pickers share a row, and a German
             "Keine Dämpfung" is wider than half a narrow card (#1047). Open, each entry says itself whole. -->
        <DataTemplate x:Key="WrappedPickerChoice" x:DataType="x:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxLines="2" TextTrimming="None" VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock x:Name="ChordStringHeader" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                   Text="{Binding Staged.ChordTechnique.Header}" ToolTip.Tip="{Binding Staged.ChordTechnique.Header}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}">
            <ItemsControl x:Name="ChordStringKeys" Grid.Column="0" ItemsSource="{Binding Staged.ChordTechnique.Strings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inspectorVm:StagedStringChip">
                        <ToggleButton Theme="{StaticResource ColumnFlowNavToggle}" Classes="ColumnFlowNav" MinWidth="28"
                                      Content="{Binding Label}" IsChecked="{Binding IsActive, Mode=OneWay}"
                                      IsEnabled="{Binding IsPlayed}"
                                      Command="{Binding $parent[ItemsControl].((viewModels:InspectorViewModel)DataContext).Staged.ChordTechnique.SelectStringCommand, FallbackValue={x:Null}}"
                                      CommandParameter="{Binding StringIndex}"
                                      AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="ChordStringMask" Grid.Column="1" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                    Content="{Binding Staged.ChordTechnique.MaskLabel}"
                    Command="{Binding Staged.ChordTechnique.ToggleMaskCommand}"
                    AutomationProperties.Name="{localization:Loc Inspector_Staged_MaskTip}"
                    ToolTip.Tip="{localization:Loc Inspector_Staged_MaskTip}" />
        </Grid>
        <TextBlock x:Name="ChordStringNotEditable" Text="{Binding Staged.ChordTechnique.NotEditableText}" TextWrapping="Wrap"
                   IsVisible="{Binding Staged.ChordTechnique.IsNotEditable}"
                   FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireWarning}" />
        <StackPanel x:Name="ChordPerStringRows" Spacing="3" IsEnabled="{Binding Staged.ChordTechnique.IsEditable}">
            <UniformGrid Columns="2" ColumnSpacing="{StaticResource SpaceXs}" RowSpacing="3">
                <ComboBox x:Name="ChordMutePicker" HorizontalAlignment="Stretch" SelectionBoxItemTemplate="{StaticResource WrappedPickerChoice}"
                          SelectedIndex="{Binding Staged.ChordTechnique.Mute}"
                          AutomationProperties.Name="{localization:Loc Inspector_Mute}" ToolTip.Tip="{localization:Loc Inspector_Mute}">
                    <ComboBoxItem Content="{localization:Loc Inspector_Staged_NoMute}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_FullMute}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_PalmMute}" />
                </ComboBox>
                <ComboBox x:Name="ChordHarmonicPicker" HorizontalAlignment="Stretch" SelectionBoxItemTemplate="{StaticResource WrappedPickerChoice}"
                          SelectedIndex="{Binding Staged.ChordTechnique.Harmonic}"
                          AutomationProperties.Name="{localization:Loc Inspector_Harmonic}" ToolTip.Tip="{localization:Loc Inspector_Harmonic}">
                    <ComboBoxItem Content="{localization:Loc Inspector_Staged_NoHarmonic}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_Normal}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_Pinch}" />
                </ComboBox>
                <ComboBox x:Name="ChordPickingPicker" HorizontalAlignment="Stretch" SelectionBoxItemTemplate="{StaticResource WrappedPickerChoice}"
                          SelectedIndex="{Binding Staged.ChordTechnique.BassPicking}"
                          AutomationProperties.Name="{localization:Loc Inspector_Picking}" ToolTip.Tip="{localization:Loc Inspector_Picking}">
                    <ComboBoxItem Content="{localization:Loc Inspector_Staged_NoPopSlap}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_Pop}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_Slap}" />
                </ComboBox>
                <ComboBox x:Name="ChordHopoPicker" HorizontalAlignment="Stretch" SelectionBoxItemTemplate="{StaticResource WrappedPickerChoice}"
                          SelectedIndex="{Binding Staged.ChordTechnique.Hopo}"
                          AutomationProperties.Name="{localization:Loc Inspector_Hopo}" ToolTip.Tip="{localization:Loc Inspector_Hopo}">
                    <ComboBoxItem Content="{localization:Loc Inspector_Staged_NoLegato}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_HammerOn}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_PullOff}" />
                    <ComboBoxItem Content="{localization:Loc Inspector_Tap}" />
                </ComboBox>
            </UniformGrid>
            <UniformGrid Columns="3" ColumnSpacing="{StaticResource SpaceXs}" RowSpacing="3">
                <ToggleButton x:Name="ChordVibratoChip" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                              HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Vibrato}"
                              IsChecked="{Binding Staged.ChordTechnique.Vibrato}"
                              AutomationProperties.Name="{localization:Loc Inspector_Vibrato}"
                              ToolTip.Tip="{localization:Loc Inspector_Chord_VibratoTip}" />
                <ToggleButton x:Name="ChordSlideChip" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                              HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Slide}"
                              IsChecked="{Binding Staged.ChordTechnique.UnpitchedSlide}"
                              AutomationProperties.Name="{localization:Loc Inspector_Slide}"
                              ToolTip.Tip="{localization:Loc Inspector_Chord_SlideTip}" />
                <ToggleButton x:Name="ChordLinkNextChip" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                              HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_LinkNext}"
                              IsChecked="{Binding Staged.ChordTechnique.LinkNext}"
                              AutomationProperties.Name="{localization:Loc Inspector_LinkNext}"
                              ToolTip.Tip="{localization:Loc Inspector_Chord_LinkNextTip}" />
                <ToggleButton x:Name="ChordTremoloChip" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                              HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Tremolo}"
                              IsChecked="{Binding Staged.ChordTechnique.Tremolo}"
                              AutomationProperties.Name="{localization:Loc Inspector_Tremolo}"
                              ToolTip.Tip="{localization:Loc Inspector_Chord_TremoloTip}" />
                <ToggleButton x:Name="ChordStringIgnoreChip" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                              HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Ignore}"
                              IsChecked="{Binding Staged.ChordTechnique.StringIgnore}"
                              AutomationProperties.Name="{localization:Loc Inspector_StringIgnore}"
                              ToolTip.Tip="{localization:Loc Inspector_StringIgnoreTip}" />
                <NumericUpDown x:Name="ChordSlideToField" Classes="InspectorNumber" HorizontalAlignment="Stretch"
                               Value="{Binding Staged.ChordTechnique.SlideTo}" Minimum="0" Maximum="24"
                               PlaceholderText="{localization:Loc Inspector_SlideTo}" ShowButtonSpinner="False"
                               AutomationProperties.Name="{localization:Loc Inspector_SlideTo}"
                               ToolTip.Tip="{localization:Loc Inspector_Chord_SlideToTip}" />
            </UniformGrid>
        </StackPanel>
        <UniformGrid Columns="2" ColumnSpacing="{StaticResource SpaceXs}">
            <Button x:Name="ChordCopyToStrings" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                    HorizontalAlignment="Stretch" Content="{Binding Staged.ChordTechnique.CopyLabel}"
                    Command="{Binding Staged.ChordTechnique.CopyToStringsCommand}" IsEnabled="{Binding Staged.ChordTechnique.CanCopy}"
                    AutomationProperties.Name="{localization:Loc Inspector_ApplyTechToAll}"
                    ToolTip.Tip="{localization:Loc Inspector_Staged_CopyTip}" />
            <Button x:Name="ChordClearMask" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                    HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Scope_ClearMask}"
                    Command="{Binding StringMask.ClearStringMaskCommand}"
                    AutomationProperties.Name="{localization:Loc Inspector_Scope_ClearMask}"
                    ToolTip.Tip="{localization:Loc Inspector_Scope_ClearMaskTip}" />
        </UniformGrid>
    </StackPanel>
</UserControl>

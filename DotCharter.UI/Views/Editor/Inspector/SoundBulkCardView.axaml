<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundBulkCardView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Selection page's MOVE card (#751 P4, design D's "Move N sounds now"): fret, string and sustain steps
         on the whole selection, written AT ONCE (one history node each; Staged.Selection.Move*). A step that
         reaches several sounds, or leaves one where it is (off the neck, a sustain clamp), asks first in the
         footer (Confirm / Cancel). Chords move every fretted string; the sustain step is the timeline grid's. -->
    <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                   Text="{Binding Staged.Selection.MoveTitle}" />
        <TextBlock Text="{Binding Staged.Selection.MoveSummary}" TextWrapping="Wrap"
                   FontSize="{StaticResource FireSizeXs}" Foreground="{DynamicResource FireTextMuted}" />
        <Grid x:Name="SoundBulkMoveRows" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="3">
            <TextBlock Grid.Row="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_Fret}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="3">
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="−12"
                        Command="{Binding Staged.Selection.MoveFretCommand}" CommandParameter="-12"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_FretDown12}" />
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="−1"
                        Command="{Binding Staged.Selection.MoveFretCommand}" CommandParameter="-1"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_FretDown1}" />
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="+1"
                        Command="{Binding Staged.Selection.MoveFretCommand}" CommandParameter="1"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_FretUp1}" />
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="+12"
                        Command="{Binding Staged.Selection.MoveFretCommand}" CommandParameter="12"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_FretUp12}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_String}" ToolTip.Tip="{localization:Loc Inspector_Bulk_StringTip}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="−1"
                        Command="{Binding Staged.Selection.MoveStringCommand}" CommandParameter="-1"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_StringDown}"
                        ToolTip.Tip="{localization:Loc Inspector_Bulk_StringTip}" />
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="+1"
                        Command="{Binding Staged.Selection.MoveStringCommand}" CommandParameter="1"
                        AutomationProperties.Name="{localization:Loc Inspector_Staged_StringUp}"
                        ToolTip.Tip="{localization:Loc Inspector_Bulk_StringTip}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_NoteLength}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="{localization:Loc Inspector_Staged_StepDown}"
                        Command="{Binding Staged.Selection.MoveSustainCommand}" CommandParameter="-1"
                        AutomationProperties.Name="{localization:Loc Inspector_LengthStepDownTip}"
                        ToolTip.Tip="{localization:Loc Inspector_LengthStepDownTip}" />
                <Button Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton" Content="{localization:Loc Inspector_Staged_StepUp}"
                        Command="{Binding Staged.Selection.MoveSustainCommand}" CommandParameter="1"
                        AutomationProperties.Name="{localization:Loc Inspector_LengthStepUpTip}"
                        ToolTip.Tip="{localization:Loc Inspector_LengthStepUpTip}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel"
                       Text="{localization:Loc Inspector_Staged_FirstSoundLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Staged.Selection.FirstSound}" HorizontalAlignment="Right"
                       FontFamily="{StaticResource FireFontMono}" FontSize="{StaticResource FireSizeXs}"
                       Foreground="{DynamicResource FireTextBright}" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>

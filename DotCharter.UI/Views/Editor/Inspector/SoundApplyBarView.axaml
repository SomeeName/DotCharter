<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DotCharter.UI.Controls"
             xmlns:panels="clr-namespace:DotCharter.UI.ViewModels.Panels;assembly=DotCharter"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundApplyBarView"
             x:DataType="panels:ChordTemplateEditorViewModel">
    <!-- The Sound tab's ONE pinned "Apply to" row (#601): the #484 ladder as a picker, pinned
         over a chord's Shape, Technique and Bends sections only (#604; SoundSectionsViewModel.ShowApplyBar).
         EVERY edit there reaches exactly the rung it shows: the box shows the rung the next edit
         TAKES (Ladder.Effective, kept there by the code-behind), so it and the reach beside it
         always agree; a pick goes through ChooseApplyRung, the ladder's own verb. A rung with
         nothing to reach is disabled, and every rung keeps its reach and its reason in its
         tooltip and its accessible name. ONE row (inspector design D's footer): the picker, which
         shows the rung's short label while closed (ChordApplyRungRow.ShortLabel), and a SHORT reach
         (Ladder.EffectiveShortDetail; the whole one is its tooltip). The bulk-edit
         preview (#485) and the refused reshape hint stand in the Note tab's pinned strip over the
         footer (SoundInspectorView `NoteApplyStrip`). -->
    <StackPanel Spacing="{StaticResource SpaceXxs}">
        <!-- No visible "Apply to" caption (design D's footer): the picker is NAMED by it and its tooltip says the
             whole reach. -->
        <Grid x:Name="SoundApplyRow" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}"
              IsVisible="{Binding Ladder.IsVisible}">
            <!-- The rungs are the ladder's own ROWS, drawn by a template, so the box shows the
                 row's label as it is NOW (a bound ComboBoxItem.Content was copied at pick time
                 and kept "selected (0)" after a chord was selected). -->
            <ComboBox x:Name="SoundApplyPicker" Grid.Column="0" MinWidth="0" MaxWidth="220" MinHeight="0" Height="24"
                      Padding="{StaticResource FirePadTag}" FontSize="{StaticResource FireSizeXs}"
                      AutomationProperties.Name="{localization:Loc ChordTemplate_Scope_Label}"
                      ToolTip.Tip="{Binding Ladder.EffectiveDetail}"
                      ItemsSource="{Binding Ladder.Rows}">
                <ComboBox.Styles>
                    <Style Selector="ComboBoxItem" x:DataType="panels:ChordApplyRungRow">
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        <Setter Property="ToolTip.Tip" Value="{Binding ToolTipText}" />
                        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ComboBox.Styles>
                <!-- Closed, the box says the rung in a word or two ("every use"); open, each rung says itself whole. -->
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="panels:ChordApplyRungRow">
                        <TextBlock Text="{Binding ShortLabel}" />
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:ChordApplyRungRow">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- What the lit rung reaches, short: "4 chords" (the tooltip says "4 chords · 2 hand shapes · all levels"). The
                 Note footer drops it after its queue place and time, before it takes a second row. -->
            <TextBlock x:Name="SoundApplyReach" Grid.Column="1" ctl:FooterRail.DropOrder="3" Text="{Binding Ladder.EffectiveShortDetail}"
                       ToolTip.Tip="{Binding Ladder.EffectiveDetail}"
                       FontSize="{StaticResource FireSizeNano}" Foreground="{DynamicResource FireTextMuted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </StackPanel>
</UserControl>

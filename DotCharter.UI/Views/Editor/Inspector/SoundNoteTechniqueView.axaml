<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:viewModels="using:DotCharter.UI.ViewModels.Editor"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.SoundNoteTechniqueView"
             x:DataType="viewModels:InspectorViewModel">
    <!-- The Technique page of a note, its TECHNIQUES card (#751 P4, design D's "Note techniques"): mute, legato,
         harmonics and pop/slap as one-click segmented choices (a choice's index is its value; #879), Accent and Tremolo, and Reset — all
         STAGED (Staged.NoteTechnique) and written by the footer's Apply on this note or every selected note. -->
    <StackPanel Spacing="{StaticResource SpaceXs}">
        <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                   Text="{localization:Loc Inspector_Staged_NoteTechniques}" />
        <Grid x:Name="NoteTechniqueRows" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceXs}">
            <TextBlock Grid.Row="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" VerticalAlignment="Center"
                       Text="{localization:Loc Inspector_Mute}" />
            <WrapPanel Grid.Row="0" Grid.Column="1" x:Name="NoteMuteRow" Orientation="Horizontal" LineSpacing="{StaticResource SpaceXxs}">
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Content="—"
                              AutomationProperties.Name="{localization:Loc Inspector_None}"
                              ToolTip.Tip="{localization:Loc Inspector_None}"
                              IsChecked="{Binding Staged.NoteTechnique.Mute, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetMuteCommand}" CommandParameter="0" />
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_FullMute}"
                              ToolTip.Tip="{localization:Loc Inspector_FullMute}"
                              IsChecked="{Binding Staged.NoteTechnique.Mute, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetMuteCommand}" CommandParameter="1">
                    <PathIcon Data="{DynamicResource IconTechMute}" />
                </ToggleButton>
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_PalmMute}"
                              ToolTip.Tip="{localization:Loc Inspector_PalmMute}"
                              IsChecked="{Binding Staged.NoteTechnique.Mute, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetMuteCommand}" CommandParameter="2">
                    <PathIcon Data="{DynamicResource IconTechPalmMute}" />
                </ToggleButton>
            </WrapPanel>
            <TextBlock Grid.Row="1" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" VerticalAlignment="Center"
                       Text="{localization:Loc Inspector_Hopo}" />
            <WrapPanel Grid.Row="1" Grid.Column="1" x:Name="NoteHopoRow" Orientation="Horizontal" LineSpacing="{StaticResource SpaceXxs}">
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Content="—"
                              AutomationProperties.Name="{localization:Loc Inspector_None}"
                              ToolTip.Tip="{localization:Loc Inspector_None}"
                              IsChecked="{Binding Staged.NoteTechnique.Hopo, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHopoCommand}" CommandParameter="0" />
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_HammerOn}"
                              ToolTip.Tip="{localization:Loc Inspector_HammerOn}"
                              IsChecked="{Binding Staged.NoteTechnique.Hopo, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHopoCommand}" CommandParameter="1">
                    <PathIcon Data="{DynamicResource IconTechHammerOn}" />
                </ToggleButton>
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_PullOff}"
                              ToolTip.Tip="{localization:Loc Inspector_PullOff}"
                              IsChecked="{Binding Staged.NoteTechnique.Hopo, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHopoCommand}" CommandParameter="2">
                    <PathIcon Data="{DynamicResource IconTechPullOff}" />
                </ToggleButton>
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_Tap}"
                              ToolTip.Tip="{localization:Loc Inspector_Tap}"
                              IsChecked="{Binding Staged.NoteTechnique.Hopo, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=3, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHopoCommand}" CommandParameter="3">
                    <PathIcon Data="{DynamicResource IconTechTap}" />
                </ToggleButton>
            </WrapPanel>
            <TextBlock Grid.Row="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" VerticalAlignment="Center"
                       Text="{localization:Loc Inspector_Harmonic}" />
            <WrapPanel Grid.Row="2" Grid.Column="1" x:Name="NoteHarmonicRow" Orientation="Horizontal" LineSpacing="{StaticResource SpaceXxs}">
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Content="—"
                              AutomationProperties.Name="{localization:Loc Inspector_None}"
                              ToolTip.Tip="{localization:Loc Inspector_None}"
                              IsChecked="{Binding Staged.NoteTechnique.Harmonic, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHarmonicCommand}" CommandParameter="0" />
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_Normal}"
                              ToolTip.Tip="{localization:Loc Inspector_Normal}"
                              IsChecked="{Binding Staged.NoteTechnique.Harmonic, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHarmonicCommand}" CommandParameter="1">
                    <PathIcon Data="{DynamicResource IconTechHarmonic}" />
                </ToggleButton>
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_Pinch}"
                              ToolTip.Tip="{localization:Loc Inspector_Pinch}"
                              IsChecked="{Binding Staged.NoteTechnique.Harmonic, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetHarmonicCommand}" CommandParameter="2">
                    <PathIcon Data="{DynamicResource IconTechHarmonicPinch}" />
                </ToggleButton>
            </WrapPanel>
            <TextBlock Grid.Row="3" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowLabel" VerticalAlignment="Center"
                       Text="{localization:Loc Inspector_Picking}" />
            <WrapPanel Grid.Row="3" Grid.Column="1" x:Name="NotePickingRow" Orientation="Horizontal" LineSpacing="{StaticResource SpaceXxs}">
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg" Content="—"
                              AutomationProperties.Name="{localization:Loc Inspector_None}"
                              ToolTip.Tip="{localization:Loc Inspector_None}"
                              IsChecked="{Binding Staged.NoteTechnique.BassPicking, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetBassPickingCommand}" CommandParameter="0" />
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_Pop}"
                              ToolTip.Tip="{localization:Loc Inspector_Pop}"
                              IsChecked="{Binding Staged.NoteTechnique.BassPicking, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetBassPickingCommand}" CommandParameter="1">
                    <PathIcon Data="{DynamicResource IconTechPop}" />
                </ToggleButton>
                <ToggleButton Theme="{StaticResource SegToggle}" Classes="Seg"
                              AutomationProperties.Name="{localization:Loc Inspector_Slap}"
                              ToolTip.Tip="{localization:Loc Inspector_Slap}"
                              IsChecked="{Binding Staged.NoteTechnique.BassPicking, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2, Mode=OneWay}"
                              Command="{Binding Staged.NoteTechnique.SetBassPickingCommand}" CommandParameter="2">
                    <PathIcon Data="{DynamicResource IconTechSlap}" />
                </ToggleButton>
            </WrapPanel>
        </Grid>
        <UniformGrid Columns="2" ColumnSpacing="{StaticResource SpaceXs}">
            <ToggleButton x:Name="NoteAccentToggle" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                          HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Accent}"
                          IsChecked="{Binding Staged.NoteTechnique.Accent}"
                          AutomationProperties.Name="{localization:Loc Inspector_Accent}"
                          ToolTip.Tip="{localization:Loc Inspector_AccentTip}" />
            <ToggleButton x:Name="NoteTremoloToggle" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                          HorizontalAlignment="Stretch" Content="{localization:Loc Inspector_Tremolo}"
                          IsChecked="{Binding Staged.NoteTechnique.Tremolo}"
                          AutomationProperties.Name="{localization:Loc Inspector_Tremolo}"
                          ToolTip.Tip="{localization:Loc Inspector_TremoloTip}" />
        </UniformGrid>
        <Button x:Name="NoteTechniqueReset" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                HorizontalAlignment="Left" Content="{localization:Loc Inspector_ResetFlags}"
                Command="{Binding Staged.NoteTechnique.ResetCommand}"
                AutomationProperties.Name="{localization:Loc Inspector_ResetFlags}"
                ToolTip.Tip="{localization:Loc Inspector_Staged_ResetTip}" />
    </StackPanel>
</UserControl>

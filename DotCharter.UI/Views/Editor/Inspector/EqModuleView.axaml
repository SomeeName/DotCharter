<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotCharter.UI.ViewModels.Editor.Inspector;assembly=DotCharter"
             xmlns:ctl="using:DotCharter.UI.Controls"
             xmlns:inspector="using:DotCharter.UI.Views.Editor.Inspector"
             xmlns:converters="using:DotCharter.UI.Converters"
             xmlns:convertersRig="using:DotCharter.Tone.UI.Converters"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.Inspector.EqModuleView"
             x:DataType="vm:EqModuleViewModel">
    <!-- The Mixer tab's EQ section in inspector design D: a ColumnFlowPanel of three cards.
           * Response (the left column): preset, Bypass, the ColumnFlowEqPlot (drag a handle, or press
             anywhere to move the selected band there; Ctrl + wheel = Q, double-click = reset), the
             engine's reason when it has no parametric EQ, and the n/6 badge.
           * Band: the band picker, Enable / Solo / Reset, the six types, frequency, gain (or the slope of a
             gainless type) and Q. Every slider resets on a double-click to the same value Reset writes.
           * Routing: what the EQ is applied to, and the output trim.
         Small and Tiny page the Band and Routing cards (Tiny pages all three, ColumnFlowPages); a wide pane
         gives each its own column. Every control writes through EqModuleViewModel's one commit path, which
         pushes the section to the engine: nothing here touches audio. -->
    <ctl:ColumnFlowPanel x:Name="EqCards">
        <ctl:ColumnFlowCard x:Name="EqResponseCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Response}">
            <StackPanel Spacing="{StaticResource FireSpaceXs}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading"
                               Text="{localization:Loc Mixer_Eq_Response}" />
                    <TextBlock Grid.Column="1" x:Name="EqActiveBadge" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowStamp"
                               Text="{Binding ActiveBadge}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource FireSpaceXs}">
                    <ComboBox Grid.Column="0" x:Name="EqPreset" Classes="ColumnFlowField"
                              AutomationProperties.Name="{localization:Loc Inspector_EqPreset}"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPresetKey}"
                              IsEnabled="{Binding IsLive}"
                              PlaceholderText="{localization:Loc Inspector_EqPresetCustom}"
                              ToolTip.Tip="{localization:Loc Inspector_EqPresetTip}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding Converter={x:Static converters:EqPresetLabelConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton Grid.Column="1" x:Name="EqBypass" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                  Content="{localization:Loc Mixer_Eq_Bypass}"
                                  IsChecked="{Binding IsBypassed}"
                                  IsEnabled="{Binding IsLive}"
                                  AutomationProperties.Name="{localization:Loc Mixer_Eq_Bypass}"
                                  ToolTip.Tip="{localization:Loc Inspector_EqPowerTip}" />
                </Grid>
                <Border Background="{DynamicResource FireSurfaceSunken}" CornerRadius="{StaticResource FireRadiusMicro}"
                        ToolTip.Tip="{localization:Loc Inspector_EqPlotTip}">
                    <ctl:ColumnFlowEqPlot x:Name="Plot" PreferredHeight="96"
                                          Section="{Binding Section}"
                                          SelectedBand="{Binding SelectedIndex, Mode=TwoWay}"
                                          Spectrum="{Binding Spectrum}"
                                          IsLive="{Binding IsLive}"
                                          PreviewLabel="{localization:Loc Inspector_EqPreviewTag}"
                                          TextElement.FontFamily="{StaticResource FireFontMono}" />
                </Border>
                <!-- The engine's own reason: a control that is off says why. -->
                <TextBlock x:Name="EqUnavailableText" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                           Foreground="{DynamicResource FireWarning}"
                           Text="{Binding UnavailableReason}" IsVisible="{Binding !IsLive}" />
                <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                           Text="{localization:Loc Mixer_Eq_Hint}" IsVisible="{Binding IsLive}" />
            </StackPanel>
        </ctl:ColumnFlowCard>

        <ctl:ColumnFlowCard x:Name="EqBandCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Band}">
            <StackPanel Spacing="{StaticResource FireSpaceXs}" IsEnabled="{Binding IsLive}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FireSpaceXs}">
                    <Ellipse x:Name="EqBandTitleDot" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding SelectedColorToken, Converter={x:Static convertersRig:FireTokenBrushConverter.Instance}}" />
                    <TextBlock x:Name="EqBandTitle" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{Binding SelectedTitle}" />
                </StackPanel>
                <!-- the chip row (restored): a chip selects its band in one click; its dot switches the band on or off
                     without selecting it. The colour is the band's plot handle. -->
                <ItemsControl x:Name="EqBandChips" ItemsSource="{Binding Bands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EqBandChipViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,3,3">
                                <Button Grid.Column="0" x:Name="EqChipPower" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                                        MinWidth="24" Padding="0"
                                        Command="{Binding ToggleEnabledCommand}"
                                        AutomationProperties.Name="{Binding ToggleLabel}"
                                        ToolTip.Tip="{Binding ToggleLabel}">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorToken, Converter={x:Static convertersRig:FireTokenBrushConverter.Instance}}"
                                             Opacity="{Binding !IsEnabled, Converter={x:Static converters:BoolConverters.ToDimmedOpacity}}" />
                                </Button>
                                <ToggleButton Grid.Column="1" x:Name="EqChipSelect" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                              HorizontalAlignment="Stretch" Padding="2,0"
                                              Content="{Binding ChipLabel}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding SelectCommand}"
                                              AutomationProperties.Name="{Binding PickerLabel}"
                                              ToolTip.Tip="{Binding PickerLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource FireSpaceXs}">
                    <ComboBox Grid.Column="0" x:Name="EqBandPicker" Classes="ColumnFlowField"
                              AutomationProperties.Name="{localization:Loc Mixer_Card_Band}"
                              ItemsSource="{Binding Bands}"
                              SelectedIndex="{Binding SelectedIndex}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EqBandChipViewModel">
                                <!-- a band that is off reads dimmed, as its plot handle does -->
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FireSpaceXs}"
                                            Opacity="{Binding !IsEnabled, Converter={x:Static converters:BoolConverters.ToDimmedOpacity}}">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ColorToken, Converter={x:Static convertersRig:FireTokenBrushConverter.Instance}}" />
                                    <TextBlock Text="{Binding PickerLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton Grid.Column="1" x:Name="EqBandEnable" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                  HorizontalAlignment="Stretch"
                                  Content="{localization:Loc Mixer_Eq_Enable}"
                                  IsChecked="{Binding SelectedBand.IsEnabled, Mode=OneWay}"
                                  Command="{Binding SelectedBand.ToggleEnabledCommand}"
                                  AutomationProperties.Name="{localization:Loc Mixer_Eq_Enable}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource FireSpaceXs}">
                    <ToggleButton Grid.Column="0" x:Name="EqBandSolo" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                  HorizontalAlignment="Stretch"
                                  Content="{localization:Loc Inspector_EqSolo}"
                                  IsChecked="{Binding IsSelectedSoloed, Mode=OneWay}"
                                  Command="{Binding ToggleSoloCommand}"
                                  IsEnabled="{Binding SelectedBand.IsEnabled}"
                                  ToolTip.ShowOnDisabled="True"
                                  AutomationProperties.Name="{localization:Loc Inspector_EqSolo}"
                                  ToolTip.Tip="{localization:Loc Mixer_Eq_SoloTip}" />
                    <Button Grid.Column="1" x:Name="EqBandReset" Theme="{StaticResource ColumnFlowButton}" Classes="ColumnFlowButton"
                            HorizontalAlignment="Stretch"
                            Content="{localization:Loc Mixer_Eq_ResetGainQ}"
                            Command="{Binding Edits.ResetCommand}"
                            ToolTip.Tip="{localization:Loc Mixer_Eq_ResetGainQTip}"
                            AutomationProperties.Name="{localization:Loc Mixer_Eq_ResetGainQ}" />
                </Grid>
                <!-- Reset gain + Q and the typed Frequency / Gain / Q fields bind EqBandEdits (EqModuleViewModel.Edits): its
                     ResetCommand, CommitFrequencyCommand, CommitGainCommand and CommitQCommand. -->
                <inspector:InspectorConfirmRow x:Name="EqResetConfirm" DataContext="{Binding Edits.ResetConfirm}" />
                <ItemsControl x:Name="EqBandTypes" ItemsSource="{Binding Types}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EqTypeOptionViewModel">
                            <ToggleButton Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle" Margin="0,0,3,3"
                                          HorizontalAlignment="Stretch"
                                          Content="{Binding Label}"
                                          AutomationProperties.Name="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding PickCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqFreq}" />
                    <Slider Grid.Column="1" Classes="MixerSlider" Minimum="0" Maximum="1"
                            AutomationProperties.Name="{localization:Loc Inspector_EqFreq}" Value="{Binding SelectedFrequencyNormalized}"
                            ctl:ResetOnDoubleClick.DefaultValue="{Binding SelectedFrequencyDefaultNormalized}"
                            ToolTip.Tip="{localization:Loc Inspector_DoubleClickReset}"
                            Foreground="{DynamicResource FireAccent}" />
                    <TextBox Grid.Column="2" x:Name="EqFreqField" Classes="ColumnFlowField" Width="76"
                             Text="{Binding Edits.FrequencyInput}" Tag="{Binding Edits.CommitFrequencyCommand}"
                             LostFocus="CommitField"
                             AutomationProperties.Name="{localization:Loc Inspector_EqFreq}"
                             ToolTip.Tip="{Binding SelectedFrequencyText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Edits.CommitFrequencyCommand}" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerRightContent>
                            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" VerticalAlignment="Center" Margin="0,0,4,0" Text="Hz" />
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Grid>
                <!-- Gain, or the slope of a type that has none: never a gain the filter cannot apply. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}" IsVisible="{Binding SelectedHasGain}">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqGain}" />
                    <Slider Grid.Column="1" Classes="MixerSlider" Minimum="-18" Maximum="18"
                            AutomationProperties.Name="{localization:Loc Inspector_EqGain}" Value="{Binding SelectedGainDb}"
                            ctl:ResetOnDoubleClick.DefaultValue="{Binding GainDefaultDb}"
                            ToolTip.Tip="{localization:Loc Inspector_DoubleClickReset}"
                            Foreground="{DynamicResource FireAccent}" />
                    <TextBox Grid.Column="2" x:Name="EqGainField" Classes="ColumnFlowField" Width="76"
                             Text="{Binding Edits.GainInput}" Tag="{Binding Edits.CommitGainCommand}"
                             LostFocus="CommitField"
                             AutomationProperties.Name="{localization:Loc Inspector_EqGain}"
                             ToolTip.Tip="{Binding SelectedGainText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Edits.CommitGainCommand}" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerRightContent>
                            <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" VerticalAlignment="Center" Margin="0,0,4,0" Text="dB" />
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}" IsVisible="{Binding !SelectedHasGain}">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqSlopeLabel}" />
                    <TextBlock Grid.Column="1" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqNoGain}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue" Text="{Binding SelectedSlopeText}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqQ}" />
                    <Slider Grid.Column="1" Classes="MixerSlider" Minimum="0" Maximum="1"
                            AutomationProperties.Name="{localization:Loc Inspector_EqQ}" Value="{Binding SelectedQNormalized}"
                            ctl:ResetOnDoubleClick.DefaultValue="{Binding QDefaultNormalized}"
                            ToolTip.Tip="{localization:Loc Inspector_DoubleClickReset}"
                            Foreground="{DynamicResource FireBorderStrong}" />
                    <TextBox Grid.Column="2" x:Name="EqQField" Classes="ColumnFlowField" Width="76"
                             Text="{Binding Edits.QInput}" Tag="{Binding Edits.CommitQCommand}"
                             LostFocus="CommitField"
                             AutomationProperties.Name="{localization:Loc Inspector_EqQ}"
                             ToolTip.Tip="{Binding SelectedQText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Edits.CommitQCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Grid>
                <TextBlock x:Name="EqFieldError" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap"
                           Foreground="{DynamicResource FireWarning}"
                           IsVisible="{Binding Edits.HasError}" Text="{Binding Edits.Error}" />
            </StackPanel>
        </ctl:ColumnFlowCard>

        <ctl:ColumnFlowCard x:Name="EqRoutingCard" ctl:ColumnFlowPanel.Title="{localization:Loc Mixer_Card_Routing}">
            <StackPanel Spacing="{StaticResource FireSpaceXs}" IsEnabled="{Binding IsLive}">
                <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowHeading" Text="{localization:Loc Mixer_Eq_Routing}" />
                <TextBlock Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" TextWrapping="Wrap" Text="{localization:Loc Inspector_EqRouteTip}" />
                <UniformGrid Columns="3">
                    <ToggleButton x:Name="EqRouteSong" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle" Margin="0,0,3,0"
                                  HorizontalAlignment="Stretch"
                                  Content="{localization:Loc Inspector_EqRouteSong}" AutomationProperties.Name="{localization:Loc Inspector_EqRouteSong}"
                                  IsChecked="{Binding IsRouteSong, Mode=OneWay}" Command="{Binding SetRouteSongCommand}" />
                    <ToggleButton x:Name="EqRouteGuitar" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle" Margin="0,0,3,0"
                                  HorizontalAlignment="Stretch"
                                  Content="{localization:Loc Inspector_EqRouteGuitar}" AutomationProperties.Name="{localization:Loc Inspector_EqRouteGuitar}"
                                  IsChecked="{Binding IsRouteGuitar, Mode=OneWay}" Command="{Binding SetRouteGuitarCommand}" />
                    <ToggleButton x:Name="EqRouteBoth" Theme="{StaticResource ColumnFlowToggle}" Classes="ColumnFlowToggle"
                                  HorizontalAlignment="Stretch"
                                  Content="{localization:Loc Inspector_EqRouteBoth}" AutomationProperties.Name="{localization:Loc Inspector_EqRouteBoth}"
                                  IsChecked="{Binding IsRouteBoth, Mode=OneWay}" Command="{Binding SetRouteBothCommand}" />
                </UniformGrid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource FireSpaceSm}">
                    <TextBlock Grid.Column="0" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowMuted" Text="{localization:Loc Inspector_EqTrim}" />
                    <Slider Grid.Column="1" Classes="MixerSlider" Minimum="-12" Maximum="12"
                            AutomationProperties.Name="{localization:Loc Inspector_EqTrim}" Value="{Binding TrimDb}"
                            ctl:ResetOnDoubleClick.DefaultValue="{Binding TrimDefaultDb}"
                            ToolTip.Tip="{localization:Loc Inspector_DoubleClickReset}"
                            Foreground="{DynamicResource FireAccent}" />
                    <TextBlock Grid.Column="2" Theme="{StaticResource ColumnFlowText}" Classes="ColumnFlowValue" Text="{Binding TrimText}" />
                </Grid>
            </StackPanel>
        </ctl:ColumnFlowCard>
    </ctl:ColumnFlowPanel>
</UserControl>

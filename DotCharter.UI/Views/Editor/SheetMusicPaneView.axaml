<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotCharter.UI.ViewModels.Editor"
             xmlns:sheetControls="clr-namespace:DotCharter.UI.Controls.Sheet;assembly=DotCharter"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Editor.SheetMusicPaneView"
             x:DataType="vm:SheetMusicPaneViewModel">
    <Grid>
        <sheetControls:SheetMusicView x:Name="Sheet"
                                      ProjectState="{Binding ProjectState}"
                                      Selection="{Binding Selection}"
                                      History="{Binding History}"
                                      UserScale="{Binding SheetZoom, Mode=TwoWay}"
                                      StavesMode="{Binding SheetStaves}"
                                      PageMode="{Binding SheetPageMode}" />

        <!-- Floating note-value (duration) palette. Applies the authored notation
             duration to the selected note(s)/beat; dotted/triplet are input
             modifiers. +/- on the focused sheet halve/double it (GP muscle
             memory). Labels are note-value denominators (1 = whole … 64). -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="18,6,0,0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="2" Opacity="0.92">
            <StackPanel Orientation="Horizontal" Spacing="2"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Tip}">
                <Button Content="1" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="1"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Whole}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Whole}" />
                <Button Content="2" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="2"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Half}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Half}" />
                <Button Content="4" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="4"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Quarter}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Quarter}" />
                <Button Content="8" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="8"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Eighth}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Eighth}" />
                <Button Content="16" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="16"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Sixteenth}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Sixteenth}" />
                <Button Content="32" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="32"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_ThirtySecond}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_ThirtySecond}" />
                <Button Content="64" Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ApplyDurationValueCommand}" CommandParameter="64"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_SixtyFourth}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_SixtyFourth}" />
                <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="2,2" />
                <ToggleButton Content="." MinHeight="20" Padding="7,0"
                              FontSize="{StaticResource FontSizeMd}"
                              IsChecked="{Binding DurationDotted, Mode=TwoWay}"
                              ToolTip.Tip="{localization:Loc SheetMusic_Duration_Dotted}"
                              AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Dotted}" />
                <ToggleButton Content="3" MinHeight="20" Padding="6,0"
                              FontSize="{StaticResource FontSizeXs}"
                              IsChecked="{Binding DurationTriplet, Mode=TwoWay}"
                              ToolTip.Tip="{localization:Loc SheetMusic_Duration_Triplet}"
                              AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Triplet}" />
                <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="2,2" />
                <Button Content="{localization:Loc SheetMusic_Duration_ClearLabel}"
                        Theme="{StaticResource SubtleButton}" Classes="Subtle Compact" MinHeight="20" Padding="6,0"
                        FontSize="{StaticResource FontSizeXs}"
                        Command="{Binding ClearDurationCommand}"
                        ToolTip.Tip="{localization:Loc SheetMusic_Duration_Clear}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_Duration_Clear}" />
            </StackPanel>
        </Border>

        <!-- Floating stave + zoom controls (Ctrl+wheel zooms too). -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,18,0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}" Padding="2" Opacity="0.92">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton IsChecked="{Binding SheetPageMode, Mode=TwoWay}"
                              MinHeight="20" Padding="6,0"
                              FontSize="{StaticResource FontSizeXs}"
                              Content="{localization:Loc SheetMusic_Layout_Page}"
                              ToolTip.Tip="{localization:Loc SheetMusic_Layout_Tip}"
                              AutomationProperties.Name="{localization:Loc SheetMusic_Layout_Tip}" />
                <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="2,2" />
                <ComboBox SelectedIndex="{Binding SheetStaves}" MinWidth="104"
                          FontSize="{StaticResource FontSizeXs}" MinHeight="20" Padding="6,1"
                          ToolTip.Tip="{localization:Loc SheetMusic_Staves_Tip}"
                          AutomationProperties.Name="{localization:Loc SheetMusic_Staves_Tip}">
                    <ComboBoxItem Content="{localization:Loc SheetMusic_StavesBoth}" />
                    <ComboBoxItem Content="{localization:Loc SheetMusic_StavesNotation}" />
                    <ComboBoxItem Content="{localization:Loc SheetMusic_StavesTab}" />
                </ComboBox>
                <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="2,2" />
                <Button Content="−" Command="{Binding ZoomOutCommand}"
                        Padding="7,0" FontSize="{StaticResource FontSizeMd}" MinHeight="20"
                        ToolTip.Tip="{localization:Loc SheetMusic_ZoomOut}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_ZoomOut}" />
                <TextBlock Text="{Binding SheetZoom, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" MinWidth="42"
                           TextAlignment="Center" FontSize="{StaticResource FontSizeXs}"
                           Foreground="{DynamicResource TextSecondary}" />
                <Button Content="+" Command="{Binding ZoomInCommand}"
                        Padding="7,0" FontSize="{StaticResource FontSizeMd}" MinHeight="20"
                        ToolTip.Tip="{localization:Loc SheetMusic_ZoomIn}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_ZoomIn}" />
                <Button Content="⟲" Command="{Binding ZoomResetCommand}"
                        Padding="7,0" FontSize="{StaticResource FontSizeSm}" MinHeight="20"
                        ToolTip.Tip="{localization:Loc SheetMusic_ZoomReset}"
                        AutomationProperties.Name="{localization:Loc SheetMusic_ZoomReset}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

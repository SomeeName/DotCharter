<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="using:DotCharter.Presentation.Contracts.Dialogs"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Dialogs.ChartDiffDialogView"
             x:DataType="contracts:IChartDiffScreen"
             x:CompileBindings="True">

    <!-- Compare this chart with another file. Grammar:
         Views/Dialogs/DialogStyles.axaml; the diff row keeps its own
         added/removed/changed colours — that IS the content. -->
    <UserControl.Styles>
        <Style Selector="Border.DiffRow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{DynamicResource PaddingRow}" />
        </Style>
        <Style Selector="TextBlock.Change">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Border.DiffRow.added TextBlock.Change">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
        </Style>
        <Style Selector="Border.DiffRow.removed TextBlock.Change">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
        </Style>
        <Style Selector="Border.DiffRow.changed TextBlock.Change">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="DialogFrame">
        <Border Theme="{DynamicResource DialogCardBorder}" Classes="DialogCard Lg">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Grid Theme="{DynamicResource DialogHeadGrid}" Grid.Row="0" Classes="DialogHead" ColumnDefinitions="Auto,*">
                    <Border Theme="{DynamicResource DialogIconBoxBorder}" Grid.Column="0" Classes="DialogIconBox">
                        <PathIcon Classes="DialogIcon" Data="{DynamicResource IconContentCopy}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Theme="{DynamicResource DialogTitleText}" Classes="DialogTitle" Text="{localization:Loc Dialog_ChartDiff_Title}" />
                        <TextBlock Theme="{DynamicResource DialogSubtitleText}" Classes="DialogSubtitle" Text="{localization:Loc Dialog_ChartDiff_Subtitle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Grid Theme="{DynamicResource DlgRowGrid}" Classes="DlgRow" ColumnDefinitions="*,340">
                        <TextBlock VerticalAlignment="Center" Theme="{DynamicResource DlgLabelText}" Grid.Column="0" Classes="DlgLabel"
                                   Text="{localization:Loc Dialog_Section_Source}" />
                        <Grid VerticalAlignment="Center" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding ComparedFileName, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="{localization:Loc Dialog_Section_Source}"
                                     PlaceholderText="{localization:Loc Dialog_ChartDiff_FileWatermark}" />
                            <Button Grid.Column="1" Theme="{DynamicResource SubtleButton}" Classes="Subtle Compact"
                                    Content="{localization:Loc Action_Browse}"
                                    Command="{Binding BrowseFileCommand}" />
                        </Grid>
                    </Grid>
                    <Grid Theme="{DynamicResource DlgRowGrid}" Classes="DlgRow Last" ColumnDefinitions="*,340"
                          IsVisible="{Binding HasComparableArrangements}">
                        <TextBlock VerticalAlignment="Center" Theme="{DynamicResource DlgLabelText}" Grid.Column="0" Classes="DlgLabel"
                                   Text="{localization:Loc Dialog_ChartDiff_Arrangement}" />
                        <ComboBox VerticalAlignment="Center" Grid.Column="1" ItemsSource="{Binding ComparableArrangements}"
                                  AutomationProperties.Name="{localization:Loc Dialog_ChartDiff_Arrangement}"
                                  SelectedIndex="{Binding SelectedArrangementIndex}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="{DynamicResource GapTopLg}">
                    <Border Theme="{DynamicResource DlgListFrameBorder}" Classes="DlgListFrame" IsVisible="{Binding HasResults}">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:IChartDiffRow">
                                        <Border Classes="DiffRow"
                                                Classes.added="{Binding IsAdded}"
                                                Classes.removed="{Binding IsRemoved}"
                                                Classes.changed="{Binding IsChanged}">
                                            <Grid ColumnDefinitions="80,130,110,*">
                                                <TextBlock Grid.Column="0" Classes="Change"
                                                           Text="{Binding Change}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Position}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="{DynamicResource FontSizeSm}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Sound}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="{DynamicResource FontSizeSm}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                           Foreground="{DynamicResource TextDim}"
                                                           FontSize="{DynamicResource FontSizeSm}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Theme="{DynamicResource DlgBodyText}" Classes="DlgBody" Text="{Binding Summary}"
                               IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Theme="{DynamicResource DlgHintText}" Classes="DlgHint" Text="{Binding Status}"
                               Margin="{DynamicResource GapTopXs}"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Theme="{DynamicResource DialogFooterBorder}" Grid.Row="3" Classes="DialogFooter">
                    <StackPanel Theme="{DynamicResource DlgActionsPanel}" Classes="DlgActions">
                        <Button Classes="DlgAction Primary" Content="{localization:Loc Action_Close}"
                                Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="using:DotCharter.Presentation.Contracts.Dialogs"
             xmlns:dlgv="clr-namespace:DotCharter.UI.Views.Dialogs;assembly=DotCharter"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             x:Class="DotCharter.UI.Views.Dialogs.PasteSpecialDialogView"
             x:DataType="contracts:IPasteSpecialScreen"
             x:CompileBindings="True">

    <!-- Grammar: Views/Dialogs/DialogStyles.axaml. Hosted by Views/Shell/DialogHost,
         whose scrim does not dismiss; Esc answers Cancel. -->
    <Grid Classes="DialogFrame">
        <Border Theme="{DynamicResource DialogCardBorder}" Classes="DialogCard Sm">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Theme="{DynamicResource DialogHeadGrid}" Grid.Row="0" Classes="DialogHead" ColumnDefinitions="Auto,*">
                    <Border Theme="{DynamicResource DialogIconBoxBorder}" Grid.Column="0" Classes="DialogIconBox">
                        <PathIcon Classes="DialogIcon" Data="{DynamicResource IconContentCopy}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Theme="{DynamicResource DialogTitleText}" Classes="DialogTitle" Text="{localization:Loc Dialog_PasteSpecial_Title}" />
                        <TextBlock Theme="{DynamicResource DialogSubtitleText}" Classes="DialogSubtitle"
                                   Text="{localization:Loc Dialog_PasteSpecial_Subtitle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Theme="{DynamicResource DlgSectionLabelText}" Classes="DlgSectionLabel" Text="{localization:Loc Dialog_Section_Mode}" />
                    <Border Theme="{DynamicResource DlgSectionBorder}" Classes="DlgSection">
                        <StackPanel Spacing="{DynamicResource SpaceLg}">
                            <RadioButton AutomationProperties.Name="{localization:Loc Dialog_PasteSpecial_Preserve}" GroupName="PasteSpecialMode" dlgv:FocusOnOpen.IsTarget="True"
                                         IsChecked="{Binding IsPreserve, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Theme="{DynamicResource DlgLabelText}" Classes="DlgLabel"
                                               Text="{localization:Loc Dialog_PasteSpecial_Preserve}" />
                                    <TextBlock Theme="{DynamicResource DlgDescText}" Classes="DlgDesc"
                                               Text="{localization:Loc Dialog_PasteSpecial_Preserve_Hint}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{localization:Loc Dialog_PasteSpecial_OverwriteSameType}" GroupName="PasteSpecialMode"
                                         IsChecked="{Binding IsOverwriteSameType, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Theme="{DynamicResource DlgLabelText}" Classes="DlgLabel"
                                               Text="{localization:Loc Dialog_PasteSpecial_OverwriteSameType}" />
                                    <TextBlock Theme="{DynamicResource DlgDescText}" Classes="DlgDesc"
                                               Text="{localization:Loc Dialog_PasteSpecial_OverwriteSameType_Hint}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="{localization:Loc Dialog_PasteSpecial_OverwriteAll}" GroupName="PasteSpecialMode"
                                         IsChecked="{Binding IsOverwriteAll, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Theme="{DynamicResource DlgLabelText}" Classes="DlgLabel"
                                               Text="{localization:Loc Dialog_PasteSpecial_OverwriteAll}" />
                                    <TextBlock Theme="{DynamicResource DlgDescText}" Classes="DlgDesc"
                                               Text="{localization:Loc Dialog_PasteSpecial_OverwriteAll_Hint}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Theme="{DynamicResource DlgRowGrid}" Classes="DlgRow Last" ColumnDefinitions="*,180">
                        <TextBlock VerticalAlignment="Center" Theme="{DynamicResource DlgLabelText}" Grid.Column="0" Classes="DlgLabel"
                                   Text="{localization:Loc Dialog_PasteSpecial_AtMouse}" />
                        <CheckBox VerticalAlignment="Center" Grid.Column="1" IsChecked="{Binding UseMousePosition}"
                                  AutomationProperties.Name="{localization:Loc Dialog_PasteSpecial_AtMouse}" />
                    </Grid>
                </StackPanel>

                <Border Theme="{DynamicResource DialogFooterBorder}" Grid.Row="2" Classes="DialogFooter">
                    <StackPanel Theme="{DynamicResource DlgActionsPanel}" Classes="DlgActions">
                        <Button Theme="{DynamicResource SubtleButton}" Classes="DlgAction Subtle" Content="{localization:Loc Action_Cancel}"
                                Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Classes="DlgAction Primary" Content="{localization:Loc Action_Apply}"
                                Command="{Binding ApplyCommand}" IsDefault="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

                        <Grid Theme="{StaticResource FormRowGrid}" IsVisible="{Binding HiddenKeys, Converter={x:Static settings:SettingsKeyVisibility.Instance}, ConverterParameter=graphics.crowdBackground}" Classes="FormRow" ColumnDefinitions="*,300">
                            <StackPanel Margin="0,8,0,0" VerticalAlignment="Top" Grid.Column="0">

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:DotCharter.UI.Converters"
             xmlns:localization="clr-namespace:DotCharter.Tone.UI.Localization;assembly=DotCharter.Tone.UI"
             xmlns:vm="using:DotCharter.UI.ViewModels.PlayMode"
             x:Class="DotCharter.UI.Views.PlayMode.Screens.FailedView"
             x:DataType="vm:PlayModeViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DotCharter/Views/PlayMode/PlayModeThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The rock-meter fail-out card. Hosted by PlayModeView, which declares
         this view with the IsFailedScreen gate; the frozen highway frame and the
         scrim under it stay in PlayModeView. The Viewbox's $parent[Panel]
         viewport binding reaches PlayModeView's root Panel (this view adds a
         UserControl and a ContentPresenter, neither a Panel). Lifted out of
         PlayModeView.axaml in #294, markup unchanged. -->
    <!-- Deliberately kept SHORT — three choices, no tool grid: this is the
         one moment the player is not in the mood to browse. -->
    <!-- P0.3 (resolution audit §4): 460x240 px, 5.3 % of a 1080p window and
         1.3 % of a 4K one, `ratio` 0.25. Same mechanism as the pause menu —
         the card keeps its design width and the Viewbox grows the whole
         figure to a share of the surface. The ceiling is lower than the
         pause menu's on purpose: this card is three choices and no tool
         grid, so filling four fifths of the height with it would be shouting. -->
    <Viewbox x:Name="FailedScreenFrame"
             Stretch="Uniform" StretchDirection="UpOnly"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             MaxWidth="{Binding $parent[Panel].Bounds,
                 Converter={x:Static conv:ViewportFractionConverter.Instance},
                 ConverterParameter=Width:0.40}"
             MaxHeight="{Binding $parent[Panel].Bounds,
                 Converter={x:Static conv:ViewportFractionConverter.Instance},
                 ConverterParameter=Height:0.62}">
    <Border Theme="{StaticResource GlassPanelBorder}" x:Name="FailedScreenRoot"
            Classes="GlassPanel" Width="460"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Border Theme="{StaticResource PlayTopLightEdgeBorder}" Classes="PlayTopLightEdge" Margin="-22,-16,-22,0" />
            <StackPanel Spacing="{StaticResource SpaceMd}">
                <StackPanel Spacing="{StaticResource SpaceXxs}">
                    <TextBlock Theme="{StaticResource EyebrowText}" Text="{localization:Loc PlayMode_RockMeter_FailEyebrow}" Classes="Eyebrow"
                               Foreground="{DynamicResource DangerColor}" />
                    <TextBlock Theme="{StaticResource ScreenTitleText}" Text="{localization:Loc PlayMode_RockMeter_FailTitle}"
                               Classes="ScreenTitle" Foreground="{DynamicResource DangerColor}" />
                    <Border Theme="{StaticResource HeaderRuleBorder}" Classes="HeaderRule" />
                    <TextBlock Theme="{StaticResource ScreenSubtitleText}" Text="{Binding FlowSongTitle}" Classes="ScreenSubtitle"
                               TextTrimming="CharacterEllipsis"
                               Margin="{StaticResource GapTopXs}" />
                </StackPanel>
                <TextBlock Text="{localization:Loc PlayMode_RockMeter_FailHint}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{DynamicResource TextMuted}" />
                <Button Theme="{StaticResource PrimaryButton}" Classes="PlayMenu Primary" Margin="{StaticResource GapTopSm}"
                        Command="{Binding RetryFromFailedSectionCommand}"
                        Content="{localization:Loc PlayMode_RockMeter_RetrySection}" />
                <Grid ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0" Theme="{StaticResource SubtleButton}" Classes="Subtle" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RestartRunCommand}"
                            Content="{localization:Loc PlayMode_RockMeter_RestartSong}" />
                    <Button Grid.Column="2" Theme="{StaticResource SubtleButton}" Classes="Subtle" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding AbortToSongSelectCommand}"
                            Content="{localization:Loc PlayMode_RockMeter_Quit}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    </Viewbox>
</UserControl>

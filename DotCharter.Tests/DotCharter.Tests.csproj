<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>DotCharter.Tests</RootNamespace>
        <!-- TestEntryPoint.cs replaces xUnit's generated Main so that a plain
             `dotnet test` (no filter) runs the gate without the headless-UI
             suite, which must never share a testhost with it. Any explicit
             filter turns that default off. See DotCharter.Tests/README.md. -->
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <!-- The plugins under plugins/ are declared here as in DotCharter.UI
             (Directory.Build.targets), so the tests find them the app's way. -->
        <DotCharterDeclarePlugins>true</DotCharterDeclarePlugins>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="coverlet.msbuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Skia" />
        <!-- Syntax trees for the Presentation source rules
             (Presentation/PresentationSourceRulesTests): type spans across
             partial files and comment trivia, which a regex cannot find. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotCharter.Analysis\DotCharter.Analysis.csproj" />
        <ProjectReference Include="..\DotCharter.Core\DotCharter.Core.csproj" />
        <ProjectReference Include="..\DotCharter.Services\DotCharter.Services.csproj" />
        <ProjectReference Include="..\DotCharter.Tone\DotCharter.Tone.csproj" />
        <ProjectReference Include="..\DotCharter.Tone.UI\DotCharter.Tone.UI.csproj" />
        <ProjectReference Include="..\DotCharter.RigLab\DotCharter.RigLab.csproj" />
        <ProjectReference Include="..\DotCharter.UI\DotCharter.UI.csproj" />
        <ProjectReference Include="..\DotCharter.Presentation\DotCharter.Presentation.csproj" />
        <ProjectReference Include="..\DotCharter.Presentation.Fakes\DotCharter.Presentation.Fakes.csproj" />
        <!-- The UI gallery. Referenced so Perf/GalleryPagesUiPerfSmokeTests can
             enumerate GalleryCatalog.All and build every page IN-PROCESS: a
             registry nobody drives is a page that silently stops constructing. -->
        <ProjectReference Include="..\DotCharter.UI.Gallery\DotCharter.UI.Gallery.csproj" />
        <!-- The dataset render tool. Referenced so Ai/Dataset/* can drive a real
             20-clip render in-process rather than shelling out: an in-process
             failure names the line, and a corpus tool nobody covers is a corpus
             nobody can trust. -->
        <ProjectReference Include="..\tools\rig-dataset\DotCharter.Tools.RigDataset\DotCharter.Tools.RigDataset.csproj" />
        <!-- The standalone lyric-sync CLI. Referenced so its argument parsing and
             exit codes are driven IN-PROCESS: spawning the executable would need
             the 340 MB acoustic model installed on whatever machine runs the gate,
             so the exit codes would be covered nowhere. -->
        <ProjectReference Include="..\tools\lyric-sync\DotCharter.LyricSync\DotCharter.LyricSync.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Real RS default tones (verbatim from Rocksmith2014.NET) used as
             parse + conversion golden-vector fixtures. -->
        <None Include="Audio\Dsp\Tones\default_lead.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Audio\Dsp\Tones\default_rhythm.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Audio\Dsp\Tones\default_bass.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- The synthetic game tables (invented numbers) the converter tests load; the optional
             plugin that builds game tables pins it to its builder (SyntheticRsGame). -->
        <None Include="Audio\Dsp\RsToneConversion\Fixtures\synthetic-rs-game-tables.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- A ~23 KB ONNX carrying the v2 rig-estimator OUTPUT SIGNATURE with
             constant answers - the additive-contract fixture
             RigEstimatorContractTests runs through the v1 reader. A real v2
             export is tens of MB and is not bundled, so a test against one could
             only ever skip. Generated by
             tools/rig-model/tests/make_contract_fixture.py. -->
        <None Include="Ai\Model\Assets\rig-estimator-v2-contract.onnx" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Ai\Model\Assets\rig-estimator-v1-label-space.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- W5b score-calibration fixtures: real MatchResultStore artefacts (the
             target, reference and candidate FEATURE VECTORS plus the per-block
             breakdown) captured from the real pipeline, so the scorer can be
             calibrated at both ends in the default gate with no audio and no engine.
             Compact JSON on one line - they are data, not something to read by eye;
             MatchScoreCalibrationTests is where they are explained. -->
        <None Include="Ai\Search\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Core\Utilities\Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Export\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Export\DynamicDifficulty\Fixtures\*.gz" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Editing\FretAnchors\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Editing\HandShapes\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Parsing\Fixtures\*.ogg" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Parsing\Fixtures\*.wem" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Services\Parsing\Fixtures\*.bin" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The top-level launcher (#413) is a NativeAOT exe that references nothing,
             so it cannot be a ProjectReference here; its pure decisions are compiled
             in by link and pinned by InstallLocationTests. -->
        <Compile Include="..\DotCharter.Launcher\LaunchCommandLine.cs" Link="Launcher\LaunchCommandLine.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(IncludeLocalOnlyHarnesses)' != 'true'">
        <!-- Local-only investigation harnesses: untracked scratch files that assert
             against the owner's own drive (E:\...), so they either fail or pass
             VACUOUSLY on any other machine — and they were compiling into the
             default gate as bare [Fact]s. Excluded from the build by default;
             opt in with `dotnet build -p:IncludeLocalOnlyHarnesses=true`.
             Kept as <None> so they stay visible in the IDE. -->
        <Compile Remove="LocalOnly_*.cs" />
        <None Include="LocalOnly_*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="DotCharter.Core.Domain.Events" />
        <Using Include="DotCharter.Core.Domain.Primitives" />
        <Using Include="DotCharter.Core.Domain.Project" />
        <Using Include="DotCharter.Core.Domain.Guitar" />
        <Using Include="DotCharter.Core.Domain.Validation" />
        <Using Include="DotCharter.Services.Editing.Improvement" />
        <Using Include="DotCharter.Services.Editing.Tempo" />
        <Using Include="DotCharter.Services.Editing.Validation" />
        <Using Include="DotCharter.Services.Infrastructure.Configuration" />
        <Using Include="DotCharter.Tone.Infrastructure.Configuration" />
        <Using Include="DotCharter.Tone.Logging" />
        <Using Include="DotCharter.Services.State" />
        <Using Include="DotCharter.Core.Utilities" />
        <Using Include="DotCharter.Tests.Infrastructure" />
    </ItemGroup>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared icon geometry (Material Design, 24x24 viewport). Use via
         <PathIcon Data="{DynamicResource IconPlay}" /> — DYNAMIC, never
         Static (2026-08-11): a StaticResource throws at construction when the
         view is built without the app dictionary in scope, and ViewLocator
         swallows that into a "Not Found:" placeholder; UI/IconResourceTests
         lints Views/** for it. Every glyph comes from this one vector set —
         no emoji, no ad-hoc text glyphs. Inline Data="M…" in a view is
         RATCHETED by the same test (the per-file counts may only shrink):
         lift a glyph here when you touch its view. The window-chrome trio in
         MainWindow.axaml is the sanctioned exception — 10x10 chrome glyphs,
         one of which is swapped from code-behind. -->
    <Styles.Resources>

        <!-- Navigation / shell -->
        <!-- the rig board's Split / Merge fork (the tone-rig design's junction glyph; Merge mirrors it) -->
        <!-- the rig header's marks (tone-rig design): the waveform brand, the cube on "Copy to both", the search glass -->
        <StreamGeometry x:Key="IconRigBrand">M4 16v4M11 9v18M18 3v30M25 9v18M32 16v4</StreamGeometry>
        <StreamGeometry x:Key="IconRigCopy">M12 3L20 7V15L12 20L4 15V7L12 3ZM12 4V14M8 8L12 4L16 8</StreamGeometry>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Part of the app theme's resource layer — see `Styles/Resources.axaml`,
         which merges this file and its siblings IN ORDER. The spacing / padding / gap / radius / elevation ladders: `Space*`
         (`x:Double`) against `Padding*`/`Gap*` (`Thickness`), which is the
         distinction `UI/ResourceTokenTypeTests` pins in both directions. -->

    <Styles.Resources>

        <!-- ─────────────────────────────────────────────────────────────
             Spacing scale (0.15.5 A1). One vocabulary for gaps and paddings:
             use the Space* doubles for StackPanel Spacing, and the semantic
             Padding*/Margin* thicknesses below for surface metrics. Policy:
             shared surface metrics (screen/card/chip paddings, stack gaps)
             come from these tokens; one-off pixel alignment nudges inside a
             single view may stay literal. Off-scale values (10, 14) snap to
             the nearest step when swept.
             ───────────────────────────────────────────────────────────── -->
        <x:Double x:Key="SpaceXxs">2</x:Double>
        <x:Double x:Key="SpaceXs">4</x:Double>
        <x:Double x:Key="SpaceSm">6</x:Double>
        <x:Double x:Key="SpaceMd">8</x:Double>
        <x:Double x:Key="SpaceLg">12</x:Double>
        <x:Double x:Key="SpaceXl">16</x:Double>
        <x:Double x:Key="SpaceXxl">20</x:Double>
        <x:Double x:Key="SpaceHuge">28</x:Double>

        <!-- Semantic surface paddings — any two panels that read as siblings
             share the same one of these. -->
        <Thickness x:Key="PaddingDialog">28</Thickness>          <!-- dialog shells -->
        <Thickness x:Key="ScreenInset">28,20</Thickness>         <!-- full-screen game surfaces (margin or padding) -->
        <Thickness x:Key="PaddingOverlayCard">20</Thickness>     <!-- centered scrimmed overlay cards -->
        <Thickness x:Key="PaddingCard">16,12</Thickness>         <!-- standard card interior -->
        <Thickness x:Key="PaddingCardLg">22,16</Thickness>       <!-- hero / stat cards -->
        <Thickness x:Key="PaddingRow">12,8</Thickness>           <!-- list-row cards -->
        <Thickness x:Key="PaddingChip">7,2</Thickness>           <!-- inline chips / badges / tags -->
        <Thickness x:Key="PaddingChipSm">5,1</Thickness>         <!-- rack-panel caps + micro chips -->
        <Thickness x:Key="PaddingNone">0</Thickness>             <!-- a control whose art IS its content -->
        <Thickness x:Key="PaddingCardSm">12,10</Thickness>        <!-- dense dock-pane cards (inspector) -->
        <Thickness x:Key="MarginOverlay">40</Thickness>          <!-- overlay card to screen edge -->

        <!-- Dense-form metrics (0.36 inspector redesign §11.3). PaddingCard
             (16,12) is too generous for a ~420 px dock pane and PaddingRow
             (12,8) means "list-row card", so the inspector's card interior gets
             its own step. The label rail and field-row height were hard-coded
             (74 / 28) in a dozen places across the two inspector tabs; 74
             already truncated Inspector_Picking in de-DE and 28 reads squished
             next to a NumericUpDown. -->
        <x:Double x:Key="FieldLabelRail">84</x:Double>
        <x:Double x:Key="RowHeightField">32</x:Double>
        <Thickness x:Key="GapChip">0,0,4,4</Thickness>            <!-- chip cluster gaps -->

        <!-- Directional gap tokens for Margin-based rhythm between siblings
             (a StackPanel Spacing can't cover mixed content). Sizes mirror
             the Space* scale. -->
        <Thickness x:Key="GapTopXs">0,4,0,0</Thickness>
        <Thickness x:Key="GapTopSm">0,6,0,0</Thickness>
        <Thickness x:Key="GapTopMd">0,8,0,0</Thickness>
        <Thickness x:Key="GapTopLg">0,12,0,0</Thickness>
        <Thickness x:Key="GapTopXl">0,16,0,0</Thickness>
        <Thickness x:Key="GapTopXxl">0,20,0,0</Thickness>
        <Thickness x:Key="GapRightXs">0,0,4,0</Thickness>
        <Thickness x:Key="GapRightSm">0,0,6,0</Thickness>
        <Thickness x:Key="GapRightMd">0,0,8,0</Thickness>
        <Thickness x:Key="GapRightLg">0,0,12,0</Thickness>
        <Thickness x:Key="GapLeftXs">4,0,0,0</Thickness>
        <Thickness x:Key="GapLeftSm">6,0,0,0</Thickness>
        <Thickness x:Key="GapLeftMd">8,0,0,0</Thickness>
        <Thickness x:Key="GapLeftLg">12,0,0,0</Thickness>
        <Thickness x:Key="GapBottomSm">0,0,0,6</Thickness>
        <Thickness x:Key="GapBottomMd">0,0,0,12</Thickness>
        <Thickness x:Key="GapBottomLg">0,0,0,20</Thickness>
        <!-- Radius scale: Xs = dense inline controls (segments, reset
             buttons), Sm = buttons/inputs, Md = cards/panels/groups,
             Lg = dialog shells. Pill shapes (Chip et al.) stay literal. -->
        <CornerRadius x:Key="RadiusXs">4</CornerRadius>
        <CornerRadius x:Key="RadiusSm">6</CornerRadius>
        <CornerRadius x:Key="RadiusMd">8</CornerRadius>
        <CornerRadius x:Key="RadiusLg">10</CornerRadius>
        <!-- The two shapes below the scale: a 4 px bar (slider track, progress,
             the selected-tab pipe, a nav row's accent edge) and the slider's
             round thumb. They were literals in five control templates until
             2026-09-20, which is one of the things that stopped a design
             proposal from being a THEME (target-architecture.md § 4). Same
             values as before — naming them changed nothing on screen. -->
        <CornerRadius x:Key="RadiusTrack">2</CornerRadius>
        <CornerRadius x:Key="RadiusThumb">7</CornerRadius>

        <!-- Border weights. A theme that wants heavier plates (the Rosewood
             proposal did) has to be able to say so in one place; these were
             literal `1` / `2` / edge thicknesses in the control themes. The
             rig's HARDWARE borders stay literal on purpose — a switch collar
             and a fader cap edge are material, like the gear artwork, not
             palette. -->
        <Thickness x:Key="BorderHairline">1</Thickness>
        <Thickness x:Key="BorderFocusRing">2</Thickness>
        <Thickness x:Key="BorderTopHairline">0,1,0,0</Thickness>
        <Thickness x:Key="BorderBottomHairline">0,0,0,1</Thickness>
        <!-- Elevation scale: Xs = flat bars, Sm = raised cards/groups,
             Md = popups/flyouts, Xl = modal dialog shells. -->
        <BoxShadows x:Key="ShadowXs">0 1 4 0 #20000000</BoxShadows>
        <BoxShadows x:Key="ShadowSm">0 2 6 0 #30000000</BoxShadows>
        <BoxShadows x:Key="ShadowMd">0 8 24 0 #50000000</BoxShadows>
        <BoxShadows x:Key="ShadowXl">0 24 64 0 #E0000000</BoxShadows>
        <!-- Settings/group card: a contact shadow at the seam plus the 1 px
             top light edge the house lighting rule asks of anything raised on
             a surface (pedalboard-visual-language.md (retired v0.43; see docs/agents/ui/pedalboard.md) R1/R3 —
             depth is EDGES, and one key light from above). Two layers, so the
             card sits on the page instead of floating over it. -->
        <BoxShadows x:Key="ShadowGroupCard">0 1 3 0 #35000000, inset 0 1 0 0 #0FFFFFFF</BoxShadows>
        <x:Double x:Key="LabelColumnWidth">140</x:Double>
    </Styles.Resources>
</Styles>

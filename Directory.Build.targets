<Project>
  <!--
    A single-project build (dotnet run / dotnet test - -project) installs the
    prebuilt native runtime before it resolves its project references when
    juce_sharp.dll is missing (#832, tools/setup/NativeRuntime.targets).
    JuceSharp's projects have their own Directory.Build.targets and never see this.
  -->
  <Import Project="tools/setup/NativeRuntime.targets" Condition="$(MSBuildProjectName.StartsWith('DotCharter'))" />
  <Target Name="DotCharterEnsureNativeRuntimeBeforeReferences" BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="DotCharterEnsureNativeRuntime" Condition="$(MSBuildProjectName.StartsWith('DotCharter'))" />

  <!--
    Optional plugins (Directory.Build.props). A project that sets DotCharterDeclarePlugins
    (DotCharter.UI, DotCharter.Tests, a plugin's own tests) carries one
    [assembly: PluginAssembly("<name>")] per project at the top of a plugins/<name>/
    folder, so PluginLoader.Declared finds them without naming any. A public build
    (DotCharterPlugins=false) declares none.
  -->
  <ItemGroup Condition="'$(DotCharterDeclarePlugins)' == 'true' And '$(DotCharterPlugins)' != 'false'">
    <DotCharterDeclaredPlugin Include="$(MSBuildThisFileDirectory)plugins\*\*.csproj" />
  </ItemGroup>
  <Target Name="DotCharterDeclarePlugins" BeforeTargets="GetAssemblyAttributes"
          Condition="'@(DotCharterDeclaredPlugin)' != ''">
    <ItemGroup>
      <AssemblyAttribute Include="DotCharter.Services.Plugins.PluginAssemblyAttribute">
        <_Parameter1>%(DotCharterDeclaredPlugin.Filename)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    A XAML-compiled project keeps its reference assembly's timestamp when the
    public surface did not change. Roslyn writes obj/refint and CopyRefAssembly
    skips the copy to obj/ref when the MVID matches, so a comment-only edit
    leaves obj/ref untouched and every dependent's Csc stays up to date. Avalonia's
    CompileAvaloniaXaml rewrites obj/refint with Cecil, which drops the PE section
    the MVID is read from, and Avalonia's own target deletes obj/ref before the
    copy: the copy always runs and obj/ref takes refint's fresh timestamp, so
    DotCharter.UI.Gallery and DotCharter.Tests recompile after every
    DotCharter.UI edit. The two targets below record obj/ref's hash and timestamp
    before that delete and put the timestamp back when the copied file has the
    same bytes. A changed surface changes the bytes, keeps the new timestamp and
    still rebuilds the dependents. -p:DotCharterKeepRefAssemblyStamp=false turns
    the pair off to measure the old behaviour. Infrastructure/RefAssemblyStabilityLintTests
    pins the pair.
  -->
  <Target Name="DotCharterRecordRefAssembly" BeforeTargets="AvaloniaDeleteRefAssemblyBeforeOutputCopy"
          Condition="'@(AvaloniaResource)@(AvaloniaXaml)' != '' and '$(TargetRefPath)' != '' and '$(ProduceReferenceAssembly)' == 'true' and '$(DotCharterKeepRefAssemblyStamp)' != 'false' and Exists('$(TargetRefPath)')">
    <ItemGroup>
      <_DotCharterRefBefore Remove="@(_DotCharterRefBefore)" />
    </ItemGroup>
    <GetFileHash Files="$(TargetRefPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_DotCharterRefBefore" />
    </GetFileHash>
    <PropertyGroup>
      <_DotCharterRefHashBefore>%(_DotCharterRefBefore.FileHash)</_DotCharterRefHashBefore>
      <_DotCharterRefTimeBefore>$([System.IO.File]::GetLastWriteTime('$(TargetRefPath)').ToString('o'))</_DotCharterRefTimeBefore>
    </PropertyGroup>
  </Target>
  <Target Name="DotCharterRestoreRefAssemblyTime" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(_DotCharterRefHashBefore)' != '' and '$(DotCharterKeepRefAssemblyStamp)' != 'false' and Exists('$(TargetRefPath)')">
    <ItemGroup>
      <_DotCharterRefAfter Remove="@(_DotCharterRefAfter)" />
    </ItemGroup>
    <GetFileHash Files="$(TargetRefPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_DotCharterRefAfter" />
    </GetFileHash>
    <Touch Files="$(TargetRefPath)" Time="$(_DotCharterRefTimeBefore)" ForceTouch="true"
           Condition="'%(_DotCharterRefAfter.FileHash)' == '$(_DotCharterRefHashBefore)'" />
  </Target>

  <!--
    The publish toolchain packages (the linker and the NativeAOT compiler) are
    PackageReferences the SDK adds itself, at the version of the runtime it
    bundles. DotCharter.UI (_RequiresILLinkPack) and DotCharter.Launcher
    (PublishAot) request them on EVERY restore, so the committed
    packages.lock.json covers the release publish graph; pinned here, that lock
    does not go stale each time a machine or CI picks up a newer SDK patch.
    Every project here targets net10.0, so the pin updates each TFM's entry alike.
    Bump this with the lock files (dotnet restore - -force-evaluate).
  -->
  <PropertyGroup>
    <DotCharterPublishToolchainVersion>10.0.13</DotCharterPublishToolchainVersion>
  </PropertyGroup>
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="$(DotCharterPublishToolchainVersion)" />
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="$(DotCharterPublishToolchainVersion)" />
  </ItemGroup>
</Project>

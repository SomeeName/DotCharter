<Project Sdk="Microsoft.NET.Sdk">

    <!--
        GLSL → SPIR-V compiler for DotCharter.Rendering/Shaders.
        Deliberately NOT part of DotCharter.sln — it is a build-time tool, run
        on demand whenever a .vert/.frag changes:

            dotnet run \-\-project tools/ShaderCompiler \-\- DotCharter.Rendering/Shaders

        It recompiles every *.vert / *.frag in the given directory into the
        committed .spv embedded resources (Vulkan 1.0 semantics, optimized).
        Uses Silk.NET.Shaderc (same Silk.NET version as the renderer) so no
        Vulkan SDK / glslc install is needed on the machine.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Shaderc"/>
        <PackageReference Include="Silk.NET.Shaderc.Native"/>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DotCharter.Presentation.Fakes</RootNamespace>
        <AssemblyName>DotCharter.Presentation.Fakes</AssemblyName>
        <DotCharterBannedApis>true</DotCharterBannedApis>
        <DotCharterBannedPresentationApis>true</DotCharterBannedPresentationApis>
    </PropertyGroup>

    <!-- Fakes of the Presentation contracts, for the gallery and tests.
         Services supplies pure format catalog data; no runtime services are resolved.
         DotCharter.UI must never reference this project (AssemblyLayeringTests). -->
    <ItemGroup>
        <ProjectReference Include="..\DotCharter.Presentation\DotCharter.Presentation.csproj" />
        <ProjectReference Include="..\DotCharter.Services\DotCharter.Services.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

</Project>
